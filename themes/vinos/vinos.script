// vinOS Plymouth theme — wordmark that toggles between two rendered
// frames to blink the trailing terminal caret. Frames are pre-composed
// (logo + on/off caret baked in) so the animation is a single sprite
// SetImage() swap — no runtime compositing, no font dependency, and
// no relative opacity math that Plymouth's script backend may drop.

Window.SetBackgroundTopColor(0.102, 0.106, 0.149);
Window.SetBackgroundBottomColor(0.102, 0.106, 0.149);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

frame0 = Image("frame-00.png");
frame1 = Image("frame-01.png");
fw = frame0.GetWidth();
fh = frame0.GetHeight();

sprite = Sprite(frame0);
sprite.SetX((screen_w - fw) / 2);
sprite.SetY((screen_h - fh) / 2);
sprite.SetZ(0);

// Blink cadence: 30 frames at ~50Hz ≈ 0.6s on / 0.6s off.
tick = 0;
current = 0;
fun refresh_cb() {
  tick++;
  desired = Math.Int(tick / 30) % 2;
  if (desired != current) {
    if (desired == 0) { sprite.SetImage(frame0); }
    else              { sprite.SetImage(frame1); }
    current = desired;
  }
}
Plymouth.SetRefreshFunction(refresh_cb);

// Silence status/progress callbacks — we don't render them, but Plymouth
// still invokes them and unhandled calls spam the debug log.
fun noop() { }
fun noop1(a) { }
fun noop2(a, b) { }

Plymouth.SetMessageFunction(noop1);
Plymouth.SetUpdateStatusFunction(noop1);
Plymouth.SetDisplayNormalFunction(noop);
Plymouth.SetDisplayPasswordFunction(noop2);
Plymouth.SetDisplayQuestionFunction(noop2);
Plymouth.SetQuitFunction(noop);
