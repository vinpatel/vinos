# vinOS mako notification config
# Brand accent (#33ccff) pinned. Separate channel for routine notifications.

# ─── Default appearance ───

font=Inter 11
width=380
height=100
padding=14,18
margin=10
border-radius=10
border-size=1
border-color=#33ccff
background-color=#0a0e14ee
text-color=#e6e6e6
progress-color=over #33ccff33

anchor=top-right
default-timeout=5000
ignore-timeout=1
max-visible=5

format=<b>%s</b>\n%b
markup=1
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
outer-margin=10,10,10,10

# ─── Category-specific styling ───

# App-name: vinos-routine — routine notifications
[app-name=vinos-routine]
border-color=#bb9af7
group-by=app-name
default-timeout=8000
format=<b>󰚉 %s</b>\n%b

# App-name: vinos-ai — AI/agent output
[app-name=vinos-ai]
border-color=#33ccff
group-by=summary
default-timeout=6000
format=<b>🧠 %s</b>\n%b

# Error urgency — persist, red border
[urgency=critical]
border-color=#ff6b6b
background-color=#3a0f0fee
default-timeout=0
format=<b>✗ %s</b>\n%b

# Low urgency — softer
[urgency=low]
default-timeout=3000
text-color=#a0a8b0

# Categories
[category=network]
border-color=#67d9a4

[category=battery]
border-color=#ffb74d

# Grouped notifications header
[grouped]
format=<b>%s</b> (%g)\n%b
