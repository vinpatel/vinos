iso/out/
iso/qa/*
# Track the harness sources, ignore whatever a run drops beside them.
# This used to be a hand-maintained allowlist, one line per gate — so a
# newly written gate was silently untracked until someone noticed. That
# is the same shape of gap as a gate that cannot see the bug it exists
# to catch, so it is a pattern now rather than a list.
!iso/qa/*.sh
!iso/qa/*.md
!iso/qa/*.txt
iso/.aur-cache/

# Q6b — dev pubkey injected at build time (per-developer, never committed).
iso/airootfs-overlay/home/vinos/.ssh/authorized_keys

# Raw source photos before watermark.sh processes them into aurora/ember/frost/nebula.
assets/wallpapers/incoming/
iso/aurrepo/
iso/aur.failed
site/public/
site/resources/
.claude/
.agents/
skills-lock.json
site/static/img/screenshots/*-serial.log
site/tools/demo/frames/

# Private planning files — never re-commit these. Scrubbed from history
# 2026-07-18 (git-filter-repo). Local copies live in ~/vinos-planning/.
CLAUDE.md
DECISIONS.md
VINOS_SPEC.md
VINOS_ISO_SPEC.md

# Tigris (Fly.io storage) credentials — per-developer, never committed.
~/.config/vinos/tigris.env
