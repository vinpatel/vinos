// overlay-applied
// vinOS fastfetch config — overridden by overlays/example.
// Mirrors the base config verbatim; the marker line above is what the
// M4 overlay-contract test greps for to confirm shadowing worked.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/vinos/logo/png/vinos-256.png",
    "padding": { "top": 1, "right": 3 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk"
  ]
}
