#!/usr/bin/env bash
#
# vinOS pre-commit hook — runs vinos-dev-lint routine before every commit.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Fast-path: if the lint harness isn't ready yet (early Phase 01), skip cleanly
if [[ ! -x "${REPO_ROOT}/iso/qa/tier1-lint.sh" ]]; then
  echo "pre-commit: tier1-lint.sh not present yet — skipping (Phase 03 will land it)"
  exit 0
fi

# Run tier1-lint directly. The vinos-routine wrapping planned in PLAN-2026-08-03
# expects a routine schema (trigger/step) that libexec/vinos-routine-run.py does
# not yet parse — so we skip that indirection until schemas converge.
"${REPO_ROOT}/iso/qa/tier1-lint.sh"
