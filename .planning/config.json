{
  "$comment": "Single source of truth for vinOS agentic dev flow. Read by GSD + Hermes. Do NOT edit copies — edit this file, then re-symlink.",

  "project": {
    "name": "vinOS",
    "code": "VINOS",
    "baseline_version": "1.1.0",
    "next_version": "1.2.0",
    "response_language": "en",
    "repo_root": "/data/projects/vinos"
  },

  "model_endpoints": {
    "$comment": "Local models via Ollama's built-in OpenAI-compat API. Claude via anthropic SDK (session auth). LiteLLM proxy deferred until Python 3.14 compat settles.",
    "local_api_base": "http://localhost:11434/v1",
    "local_api_key": "ollama",
    "anthropic_api_base": "https://api.anthropic.com/v1",
    "anthropic_api_key_env": "ANTHROPIC_API_KEY"
  },

  "models": {
    "$comment": "100% Claude Opus 4.7 (1M context) as driver until vinOS ships a stable ISO — see .planning/RULES.md.",
    "planner_model": "anthropic/claude-opus-4-7",
    "researcher_model": "anthropic/claude-opus-4-7",
    "executor_model": "anthropic/claude-opus-4-7",
    "checker_model": "anthropic/claude-opus-4-7",
    "reviewer_model": "anthropic/claude-opus-4-7",
    "architect_model": "anthropic/claude-opus-4-7",
    "kimi_local": "kimi-code:latest"
  },

  "workflow": {
    "research_enabled": true,
    "plan_checker_enabled": true,
    "nyquist_validation_enabled": true,
    "commit_docs": true,
    "auto_advance": true,
    "mvp_mode": false,
    "tdd_mode": false,
    "ui_phase": false,
    "ui_safety_gate": false,
    "plan_drift_precheck": true,
    "discuss_mode": "discuss"
  },

  "budget": {
    "per_run_usd": 0.50,
    "per_day_usd": 20.00,
    "escalation_per_run_usd": 2.00,
    "on_exceed": "notify",
    "ledger_path": "~/.vinos/dev-flow-ledger.sqlite"
  },

  "capabilities": {
    "security": {
      "enabled": true,
      "security_asvs_level": 1,
      "security_block_on": "high"
    },
    "pattern-mapper": { "enabled": true },
    "intel":          { "enabled": true },
    "drift":          { "enabled": true },
    "ai-integration": { "enabled": false }
  },

  "context_window": 200000,

  "dev_loop": {
    "$comment": "Iteration pyramid — avoid ISO burns. See docs/v2/DEV-LOOP.md.",
    "container_test_cmd": "iso/qa/container-test.sh",
    "qemu_test_cmd":      "iso/qa/oneshot.sh",
    "harness_cmd":        "iso/qa/verify-shipped-iso.sh",
    "usb_burn_gate":      "hardware-only"
  },

  "hermes_integration": {
    "$comment": "Hermes reads model config from ~/.hermes/config.json which is symlinked here. Routes local via Ollama directly.",
    "local_endpoint": "http://localhost:11434/v1",
    "anthropic_env": "ANTHROPIC_API_KEY"
  }
}
