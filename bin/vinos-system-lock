#!/bin/bash

# vinos:summary=Lock the computer and turn off the display
# vinos:group=system
# vinos:name=lock
# vinos:examples=vinos system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    vinos-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.vinos.screensaver

if [[ ${VINOS_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    vinos-brightness-keyboard off
    vinos-brightness-display off
  ) &
fi
