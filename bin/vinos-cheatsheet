#!/usr/bin/env bash
# vinos-cheatsheet — Super+? overlay: pretty-print the shipped Hyprland
# keybindings so users can discover shortcuts. Parses ~/.config/hypr/
# hyprland.conf (source of truth), groups by section-comment, and pipes
# through `less` inside a floating foot window (windowrule pins it).
#
# Non-interactive `--print` mode dumps to stdout for scripting/tests.
set -euo pipefail

CONF="${HYPR_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf}"
[[ -r "$CONF" ]] || { printf 'vinos-cheatsheet: no %s\n' "$CONF" >&2; exit 1; }

# Extract keybindings + preceding section-comment. awk emits blocks:
#   ## <section title>
#   Super+Return                  → foot
awk '
  # Section header: "# --- Something ---" or "# App shortcuts"
  /^# --- / && /--- *$/ {
    sub(/^# --- /,""); sub(/ *--- *$/,"")
    section = $0; printed_section[section] = 0; next
  }
  /^# [A-Z]/ && !/^# ---/ {
    sub(/^# /,""); section = $0; printed_section[section] = 0; next
  }
  # bind, bindl, bindm, bindel — Hyprland dispatchers. Skip bindm
  # (mouse) since it is not a keyboard chord.
  /^[[:space:]]*bind[eln]?[[:space:]]*=/ {
    line = $0
    sub(/^[[:space:]]*bind[eln]?[[:space:]]*=[[:space:]]*/,"", line)
    n = split(line, parts, /[[:space:]]*,[[:space:]]*/)
    if (n < 3) next
    mods = parts[1]; key = parts[2]; disp = parts[3]
    args = ""
    for (i = 4; i <= n; i++) args = args (args == "" ? "" : ", ") parts[i]
    # Skin the mods: SUPER → Super, SHIFT → Shift, etc.
    gsub(/\$mainMod/, "Super", mods); gsub(/SUPER/, "Super", mods)
    gsub(/SHIFT/, "Shift", mods); gsub(/CTRL/, "Ctrl", mods)
    gsub(/ALT/, "Alt", mods); gsub(/[[:space:]]+/, "+", mods)
    chord = (mods == "" ? key : mods "+" key)
    action = (disp == "exec") ? args : (disp (args == "" ? "" : " " args))
    if (section != "" && !printed_section[section]) {
      printf "\n\033[1;36m── %s ──\033[0m\n", section
      printed_section[section] = 1
    }
    printf "  \033[1;33m%-28s\033[0m %s\n", chord, action
  }
' "$CONF"

if [[ "${1:-}" == "--print" ]]; then exit 0; fi

# Interactive mode: relaunch inside a floating foot window (Hyprland
# rule floats/centers/sizes it via the app-id). If we're already inside
# that window ($VINOS_CHEATSHEET set), just page.
if [[ -z "${VINOS_CHEATSHEET:-}" ]] && command -v foot >/dev/null 2>&1; then
  exec foot --app-id=org.vinos.cheatsheet -T "vinOS keybindings" \
       -e env VINOS_CHEATSHEET=1 bash -c "'$0' --print | less -R"
fi
