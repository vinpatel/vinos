#!/usr/bin/env bash
# vinos-install-k8s — one-command Kubernetes bootstrap for local dev.
# Runs kubeadm init on this node, installs Cilium CNI, removes the
# control-plane taint so pods schedule locally, drops kubeconfig at
# ~/.kube/config, deploys a test nginx pod to verify.
#
# Usage:
#   sudo vinos-install-k8s                  # standard kubeadm cluster
#   sudo vinos-install-k8s --lightweight    # k3s instead (200MB vs 1GB)
#   sudo vinos-install-k8s --uninstall      # tear down
#
# Requires: docker running, containerd running, kernel bridge module,
# ipforward sysctl. All shipped by base vinOS 2.1.0.

set -euo pipefail

LIGHTWEIGHT=0
UNINSTALL=0
POD_CIDR="10.244.0.0/16"

log()  { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lightweight) LIGHTWEIGHT=1; shift ;;
    --uninstall)   UNINSTALL=1;   shift ;;
    --pod-cidr)    POD_CIDR="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown flag: $1" ;;
  esac
done

[[ $EUID -eq 0 ]] || die "must run as root (sudo vinos-install-k8s)"

TARGET_USER="${SUDO_USER:-$USER}"
TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)

if (( UNINSTALL )); then
  log "tearing down existing k8s cluster"
  if command -v k3s-uninstall.sh >/dev/null; then
    k3s-uninstall.sh || true
  fi
  if command -v kubeadm >/dev/null; then
    kubeadm reset -f || true
  fi
  rm -rf /etc/cni/net.d/* /var/lib/etcd /var/lib/kubelet/* 2>/dev/null || true
  rm -f "$TARGET_HOME/.kube/config" 2>/dev/null || true
  ok "cluster torn down"
  exit 0
fi

log "preflight checks"

if ! systemctl is-active --quiet docker && ! systemctl is-active --quiet containerd; then
  die "neither docker.service nor containerd.service is running — start one first"
fi
ok "container runtime is up"

if ! sysctl -n net.bridge.bridge-nf-call-iptables 2>/dev/null | grep -q '^1$'; then
  warn "bridge-nf-call-iptables=0, forcing to 1"
  modprobe br_netfilter
  sysctl -w net.bridge.bridge-nf-call-iptables=1 >/dev/null
fi
ok "bridge netfilter set"

if ! sysctl -n net.ipv4.ip_forward | grep -q '^1$'; then
  sysctl -w net.ipv4.ip_forward=1 >/dev/null
fi
ok "ip_forward set"

# Ensure swap is off — kubelet refuses to start with swap on
if swapon --show | grep -q .; then
  log "disabling swap for kubelet"
  swapoff -a
  ok "swap disabled (this session only; add 'noswap' to fstab if you want it permanent)"
fi

if (( LIGHTWEIGHT )); then
  log "installing k3s (lightweight mode)"
  if ! command -v k3s >/dev/null; then
    curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable=traefik" sh -
  fi
  ok "k3s installed and running"

  # Copy kubeconfig
  mkdir -p "$TARGET_HOME/.kube"
  cp /etc/rancher/k3s/k3s.yaml "$TARGET_HOME/.kube/config"
  chown "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.kube/config"
  chmod 600 "$TARGET_HOME/.kube/config"

  ok "kubeconfig at $TARGET_HOME/.kube/config"

  log "waiting for node to be Ready…"
  for _ in $(seq 1 30); do
    if kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml get nodes 2>/dev/null | grep -q Ready; then
      ok "node Ready"
      break
    fi
    sleep 2
  done

  log "deploying test pod"
  kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml run nginx --image=nginx --restart=Never >/dev/null || true
  ok "test pod deployed — check with: kubectl get pods"
  exit 0
fi

# Standard kubeadm path
log "installing kubeadm packages"
for pkg in kubeadm kubelet kubectl; do
  if ! command -v "$pkg" >/dev/null; then
    pacman -S --noconfirm "$pkg" 2>&1 | tail -3 || die "failed to install $pkg"
  fi
done
systemctl enable --now kubelet
ok "kubeadm + kubelet + kubectl installed"

log "kubeadm init (this takes 1-3 min)"
kubeadm init --pod-network-cidr="$POD_CIDR" --cri-socket=unix:///run/containerd/containerd.sock 2>&1 | tail -20
ok "kubeadm init done"

# kubeconfig setup for target user
mkdir -p "$TARGET_HOME/.kube"
cp /etc/kubernetes/admin.conf "$TARGET_HOME/.kube/config"
chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.kube"
chmod 600 "$TARGET_HOME/.kube/config"
ok "kubeconfig at $TARGET_HOME/.kube/config"

# Remove control-plane taint (single-node cluster)
export KUBECONFIG=/etc/kubernetes/admin.conf
kubectl taint nodes --all node-role.kubernetes.io/control-plane- 2>/dev/null || true
ok "control-plane taint removed (pods will schedule on this node)"

# Install Cilium CNI
log "installing Cilium CNI"
if ! command -v cilium >/dev/null; then
  warn "cilium CLI not installed — falling back to Flannel"
  kubectl apply -f https://github.com/flannel-io/flannel/releases/latest/download/kube-flannel.yml
else
  cilium install
fi
ok "CNI installed"

# Wait for node Ready
log "waiting for node to be Ready…"
for _ in $(seq 1 60); do
  if kubectl get nodes | grep -q Ready; then
    ok "node Ready"
    break
  fi
  sleep 3
done

# Deploy verification pod
log "deploying nginx test pod"
kubectl run nginx --image=nginx --restart=Never 2>/dev/null || true
for _ in $(seq 1 30); do
  if kubectl get pod nginx 2>/dev/null | grep -q Running; then
    ok "test pod is Running"
    break
  fi
  sleep 2
done

log ""
log "cluster ready. Try:"
log "  kubectl get nodes"
log "  kubectl get pods -A"
log "  k9s                              # TUI dashboard"
log "  vinos-k8s-status                 # health check"
log ""
log "Uninstall: sudo vinos-install-k8s --uninstall"
