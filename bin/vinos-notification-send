#!/bin/bash

# vinos:summary=Send a desktop notification with a vinOS glyph and body spacing
# vinos:args=<glyph> <headline> [description] [notify-send options]
# vinos:examples=vinos notification send "󰔛" "Reminder" "5 minutes are up" -u critical

set -euo pipefail

if (($# < 2)); then
  echo "Usage: vinos-notification-send <glyph> <headline> [description] [notify-send options]"
  exit 1
fi

glyph=$1
headline=$2
description=${3:-}
shift 2

if (($# > 0)) && [[ $1 != -* ]]; then
  shift
else
  description=""
fi

summary="$glyph    $headline"

if [[ -n $description ]]; then
  description="      ${description//$'\n'/$'\n'      }"
  notify-send "$@" "$summary" "$description"
else
  notify-send "$@" "$summary"
fi
