#!/usr/bin/env bash
# vinos-brief — show today's routine outputs. If no arg, dumps everything
# from today. If given a routine name, shows only that routine's latest.
#
# Usage:
#   vinos-brief                    Today's outputs, all routines
#   vinos-brief <name>             Latest output for one routine
#   vinos-brief --date YYYY-MM-DD  Outputs from a specific date
set -euo pipefail

STATE_DIR="${VINOS_ROUTINES_STATE:-$HOME/.vinos/routines/state}"
DATE=$(date +%Y-%m-%d)
NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --date) DATE="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) NAME="$1"; shift ;;
  esac
done

if [[ ! -d "$STATE_DIR" ]]; then
  echo "No routines have run yet. Try: vinos-routine run <name>"
  exit 0
fi

_dump() {
  local f
  for f in "$@"; do
    [[ -f "$f" ]] || continue
    cat "$f"
    printf '\n---\n\n'
  done
}

if [[ -n "$NAME" ]]; then
  latest=$(ls -1t "$STATE_DIR/$NAME/"*.md 2>/dev/null | head -1 || true)
  [[ -z "$latest" ]] && { echo "No output for '$NAME' yet."; exit 0; }
  cat "$latest"
else
  files=("$STATE_DIR"/*/"$DATE"-*.md)
  # Handle nomatch (bash keeps the glob literal when nothing matches)
  [[ -e "${files[0]}" ]] || { echo "No routines ran on $DATE."; exit 0; }
  _dump "${files[@]}"
fi
