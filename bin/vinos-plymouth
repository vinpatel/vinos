#!/usr/bin/env bash
# vinos-plymouth — set plymouth theme.
set -euo pipefail
command -v plymouth-set-default-theme >/dev/null || { echo "plymouth not installed" >&2; exit 1; }
theme="${1:-vinos}"
[[ -d "/usr/share/plymouth/themes/$theme" ]] || { echo "theme '$theme' not found" >&2; ls /usr/share/plymouth/themes/; exit 1; }
sudo plymouth-set-default-theme -R "$theme"
echo "plymouth theme: $theme"
