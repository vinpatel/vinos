#!/usr/bin/env bash
# vinos-install-disk-execute — non-interactive backend for the vinOS
# installer. Consumes the answers the wizard collected (or a CI/scripted
# caller provides) and drives archinstall + chroot layering.
#
# All I/O goes to stdout/stderr and a tee'd log at /var/log/vinos-install.log.
# No prompts. No gum. Every required answer must be passed as a flag; a
# missing required flag is a fatal error.
#
# Usage:
#   sudo vinos-install-disk-execute \
#     --disk /dev/nvme0n1 \
#     --user vin \
#     --password 'hunter2' \
#     --hostname mbp \
#     --profile t2mac \
#     [--kb-layout us] [--sys-lang en_US.UTF-8] [--timezone America/Los_Angeles] \
#     [--reboot]
#
# Prefer passing the password via VINOS_INSTALL_PASSWORD env var to keep it
# out of `ps` output; --password takes precedence if both are set.
set -euo pipefail

VINOS_PROFILE_DIR="${VINOS_PROFILE_DIR:-/usr/share/vinos/archinstall}"
VINOS_REPO_URL="${VINOS_REPO_URL:-https://github.com/vinpatel/vinos.git}"
VINOS_BRANCH="${VINOS_BRANCH:-main}"
LOG_FILE="${VINOS_INSTALL_LOG:-/var/log/vinos-install.log}"

DISK=""
USERNAME=""
HOSTNAME_="vinos"
PROFILE=""
KB_LAYOUT="us"
SYS_LANG="en_US.UTF-8"
TIMEZONE=""
KEEP_TMP=0
REBOOT=0
PASSWORD="${VINOS_INSTALL_PASSWORD:-}"

die()  { printf '\033[1;31m[install-execute] FAIL:\033[0m %s\n' "$*" | tee -a "$LOG_FILE" >&2; exit 1; }
log()  { printf '\033[1;34m[install-execute]\033[0m %s\n' "$*" | tee -a "$LOG_FILE"; }
warn() { printf '\033[1;33m[install-execute] WARN:\033[0m %s\n' "$*" | tee -a "$LOG_FILE" >&2; }

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --disk)       DISK="$2";     shift 2 ;;
    --user)       USERNAME="$2"; shift 2 ;;
    --password)   PASSWORD="$2"; shift 2 ;;
    --hostname)   HOSTNAME_="$2"; shift 2 ;;
    --profile)    PROFILE="$2";  shift 2 ;;
    --kb-layout)  KB_LAYOUT="$2"; shift 2 ;;
    --sys-lang)   SYS_LANG="$2"; shift 2 ;;
    --timezone)   TIMEZONE="$2"; shift 2 ;;
    --reboot)     REBOOT=1; shift ;;
    --keep-tmp)   KEEP_TMP=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

[[ $EUID -eq 0 ]] || die "must run as root (partitioning + pacstrap)"

# Required arguments — this is a backend, not a prompt-driven UI.
[[ -n "$DISK" ]]       || die "--disk is required"
[[ -n "$USERNAME" ]]   || die "--user is required"
[[ -n "$PASSWORD" ]]   || die "--password (or VINOS_INSTALL_PASSWORD) is required"
[[ -n "$HOSTNAME_" ]]  || die "--hostname is required"
[[ -n "$PROFILE" ]]    || die "--profile is required (t2mac|nvidia|generic)"

[[ -b "$DISK" ]]       || die "$DISK is not a block device"
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid username '$USERNAME' (must match ^[a-z_][a-z0-9_-]*$)"

TEMPLATE="$VINOS_PROFILE_DIR/${PROFILE}.json"
[[ -f "$TEMPLATE" ]] || die "profile template missing: $TEMPLATE"

# Refuse mounted disks (safety) — the wizard already checks, but this
# script may be invoked directly, so re-check here.
mounted=$(lsblk -n -o MOUNTPOINT "$DISK" | awk 'NF' | tr '\n' ' ')
for critical in / /boot /home /efi /boot/efi; do
  grep -qE "(^| )${critical}( |$)" <<<" $mounted " && \
    die "$DISK has a partition mounted at $critical — refusing to wipe"
done

install -d -m 0755 "$(dirname "$LOG_FILE")"
: > "$LOG_FILE"
chmod 0600 "$LOG_FILE"
log "vinOS install starting: disk=$DISK user=$USERNAME host=$HOSTNAME_ profile=$PROFILE"

TMPDIR=$(mktemp -d)
trap '[[ $KEEP_TMP -eq 0 ]] && rm -rf "$TMPDIR"' EXIT

RENDERED="$TMPDIR/archinstall.json"
# JSON-escape substitutions so `"` / `\` / control chars don't break parsing.
# python is guaranteed on the live ISO (archinstall drags it in).
_json_escape() { printf '%s' "$1" | python -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read())[1:-1])'; }
PW_JSON=$(_json_escape "$PASSWORD")
sed \
  -e "s|@@DISK@@|$DISK|g" \
  -e "s|@@USER@@|$USERNAME|g" \
  -e "s|@@HOSTNAME@@|$HOSTNAME_|g" \
  -e "s|@@PASSWORD@@|$PW_JSON|g" \
  -e "s|@@KB_LAYOUT@@|$KB_LAYOUT|g" \
  -e "s|@@SYS_LANG@@|$SYS_LANG|g" \
  "$TEMPLATE" > "$RENDERED"

# Templates may not carry substitution markers for kb/lang yet — sed above
# is a no-op in that case. Timezone gets injected via a small patch below
# when present, since the current templates don't carry a marker for it.
if [[ -n "$TIMEZONE" ]] && command -v python >/dev/null 2>&1; then
  python - "$RENDERED" "$TIMEZONE" <<'PY'
import json, sys
path, tz = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
data["timezone"] = tz
with open(path, "w") as f:
    json.dump(data, f, indent=2)
PY
fi
chmod 0600 "$RENDERED"  # plaintext password — keep out of world-read
log "rendered archinstall config → $RENDERED"

# ── Run archinstall ─────────────────────────────────────────────────
command -v archinstall >/dev/null || die "archinstall not found (should ship in the live ISO)"

log "running archinstall (silent) — base Arch may take 10-20 min"
if ! archinstall --config "$RENDERED" --silent 2>&1 | tee -a "$LOG_FILE"; then
  die "archinstall failed. Config kept at $RENDERED for inspection. Log: $LOG_FILE"
fi

# ── Layer vinOS via install.sh in the chroot ────────────────────────
log "base Arch installed. Layering vinOS…"
[[ -d /mnt/etc ]] || die "/mnt is not a mounted new root — archinstall didn't finish?"

arch-chroot /mnt bash -euo pipefail <<CHROOT_EOF 2>&1 | tee -a "$LOG_FILE"
# Clone the vinOS repo as the newly-created user, then run install.sh.
export HOME=/home/${USERNAME}
sudo -u ${USERNAME} -H bash -c "
  git clone --depth=1 --branch ${VINOS_BRANCH} ${VINOS_REPO_URL} \\
    /home/${USERNAME}/.local/share/vinos
  cd /home/${USERNAME}/.local/share/vinos
  # 04-services is skipped: archinstall chose the network stack, don't fight it.
  VINOS_INSTALL_ASSUME_YES=1 ./install.sh
"

# Enable the first-boot hw-detect service. Runs 06-hardware.sh once
# before graphical.target so drivers land automatically pre-login.
systemctl enable vinos-firstboot.service 2>/dev/null || true

# Password-required wheel sudoers on the INSTALLED system. The live
# ISO's NOPASSWD file lives only in the airootfs overlay and does not
# propagate to /mnt (see iso/airootfs-overlay/etc/sudoers.d/10-vinos-wheel).
install -Dm 0440 /dev/stdin /etc/sudoers.d/10-vinos-wheel <<'SUDO'
# vinOS installed-system sudoers policy.
# wheel members can sudo, but must authenticate. Do not add NOPASSWD.
%wheel ALL=(ALL:ALL) ALL
SUDO
visudo -cf /etc/sudoers.d/10-vinos-wheel >/dev/null || {
  echo "install-execute: sudoers.d/10-vinos-wheel failed visudo check" >&2
  exit 1
}

# sshd disabled by default on the installed system too — flip on with
# systemctl enable --now sshd if the user wants it.
systemctl disable sshd.service 2>/dev/null || true
CHROOT_EOF

# ── Profile-specific bootloader tweaks ──────────────────────────────
# T2 kernel + firmware install deferred to vinos-t2-enable (post-boot).
# Rationale: pacstrap can't resolve linux-t2 unless [arch-mact2] is
# registered in the target chroot's pacman.conf. Base install stays on
# stock `linux` (guaranteed to succeed); vinos-first-run detects Apple
# hardware on first login and offers to run vinos-t2-enable.
case "$PROFILE" in
  t2mac)
    log "T2 Mac: base install uses stock 'linux' kernel"
    log "        T2 support enabled post-boot via 'sudo vinos-t2-enable'"
    log "        (vinos-first-run prompts automatically on first login)"
    ;;
esac

log "vinOS install complete."
log ""
log "  disk:     $DISK"
log "  user:     $USERNAME  (password set)"
log "  hostname: $HOSTNAME_"
log "  profile:  $PROFILE"
log "  sudo:     wheel members must authenticate (installed-system default)"
log "  ssh:      disabled by default — 'systemctl enable --now sshd' to turn on"
log ""

if (( REBOOT )); then
  log "rebooting in 5s (Ctrl-C to cancel)…"
  sleep 5
  systemctl reboot
fi
