#!/usr/bin/env bash
# vinos-installer-wizard — full-screen gum TUI that walks a user from a
# just-booted vinOS ISO to a running install on their disk.
#
# Runs on tty1 from vinos-installer.service when the "Install vinOS to
# disk" boot entry is picked. Can also be launched interactively from any
# terminal (via the vinos-install-disk shim) — the two paths share this
# script and the vinos-install-disk-execute backend.
#
# Flow:
#   1. Preflight banner + hardware profile detection
#   2. Wi-Fi (skipped if a default route is already up or no radio present)
#   3. Locale (keyboard layout, timezone)
#   4. Disk selection + wipe confirmation
#   5. Account (username + password + hostname)
#   6. Confirmation summary → gum confirm
#   7. Runs vinos-install-disk-execute; tail the log while it works
#   8. Reboot prompt
#
# Ctrl-C at any point drops to a root shell on the same tty with a
# breadcrumb about how to restart the wizard.
set -uo pipefail

VINOS_PROFILE_DIR="${VINOS_PROFILE_DIR:-/usr/share/vinos/archinstall}"
LOG_FILE="${VINOS_INSTALL_LOG:-/var/log/vinos-install.log}"
STATE_DIR="${VINOS_INSTALLER_STATE:-/run/vinos-installer}"
mkdir -p "$STATE_DIR" 2>/dev/null || true

# ── styling helpers ────────────────────────────────────────────────
_have_gum() { command -v gum >/dev/null 2>&1; }

banner() {
  clear
  if _have_gum; then
    gum style --border double --margin "1 2" --padding "1 3" \
      --border-foreground "#7BA7BC" --foreground "#F5D67B" \
      "vinOS installer" "" "$(cat /usr/share/vinos/VERSION 2>/dev/null || echo dev)"
  else
    printf '\n== vinOS installer ==\n\n'
  fi
}

header() {
  if _have_gum; then
    gum style --foreground "#7BA7BC" --bold "▸ $*"
  else
    printf '\n== %s ==\n' "$*"
  fi
}

warn()  { printf '\033[1;33m! %s\033[0m\n' "$*" >&2; }
error() { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }
info()  { printf '\033[1;34m▸ %s\033[0m\n' "$*"; }

# ── ctrl-c handling: drop to root shell with instructions ──────────
_bail_to_shell() {
  local reason="${1:-cancelled}"
  clear
  warn "installer $reason."
  cat <<EOF

You are on tty1 as root. Options:
  • run  vinos-installer-wizard   to restart the installer
  • run  reboot                   to reboot the machine
  • run  poweroff                 to power off

The last install log (if any) is at $LOG_FILE.

EOF
  exec /bin/bash --login
}
trap '_bail_to_shell "interrupted"' INT TERM

# ── preflight ──────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || { error "the wizard must run as root (systemd unit runs it as root; use sudo when launching by hand)"; exit 1; }

# gum is a hard dep — bail if missing rather than silently degrading.
_have_gum || { error "gum is not installed on this system — cannot run the wizard"; exit 1; }

# ── hardware profile detection ─────────────────────────────────────
detect_profile() {
  local vendor
  vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || printf '')"
  if [[ "$vendor" == "Apple Inc." ]]; then echo "t2mac"; return; fi
  if lspci 2>/dev/null | grep -qi 'nvidia'; then echo "nvidia"; return; fi
  echo "generic"
}
PROFILE=$(detect_profile)

# ── step 1: welcome ────────────────────────────────────────────────
banner
gum style --margin "0 4" \
  "This will install vinOS to a disk you pick." \
  "Everything on the disk you pick will be erased." \
  "" \
  "Detected hardware profile: $PROFILE" \
  "" \
  "Press Enter to begin, or Ctrl-C to drop to a shell."
read -r _ || _bail_to_shell "cancelled"

# ── step 2: Wi-Fi ──────────────────────────────────────────────────
_has_route()    { ip route show default 2>/dev/null | grep -q .; }
_wifi_devices() { iwctl device list 2>/dev/null | awk 'NR>4 && $1!~/^--/ && $2 ~ /^wl/ {print $2}'; }

wifi_step() {
  banner
  header "Network"

  if _has_route; then
    info "Default route already present — skipping Wi-Fi step."
    sleep 1
    return 0
  fi

  local dev
  dev="$(_wifi_devices | head -1)"
  if [[ -z "$dev" ]]; then
    warn "No wireless device found. If you have Ethernet, plug it in now."
    gum confirm "Continue without a connection? (installer needs internet to pacstrap)" \
      && return 0 \
      || _bail_to_shell "cancelled at network step"
  fi

  # Make sure the radio is powered and iwd is up.
  rfkill unblock wifi 2>/dev/null || true
  iwctl device "$dev" set-property Powered on >/dev/null 2>&1 || true

  while :; do
    info "Scanning on $dev…"
    iwctl station "$dev" scan >/dev/null 2>&1 || true
    sleep 2
    # Parse SSIDs from `iwctl station <dev> get-networks`. Skip the header
    # rule lines and the "> Network name" caret column. Fields are
    # variable-width; awk keeps everything before the last two columns
    # (security + signal).
    mapfile -t nets < <(iwctl station "$dev" get-networks 2>/dev/null \
      | sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' \
      | awk 'NR>4 && NF>=2 { s=""; for (i=1;i<=NF-2;i++) s=(s?s" ":"")$i; sub(/^[>*]+[[:space:]]+/,"",s); if(length(s)) print s }' \
      | awk '!seen[$0]++')
    nets+=("Enter SSID manually" "Rescan" "Skip Wi-Fi (I will plug in Ethernet)")

    local ssid pass
    ssid="$(printf '%s\n' "${nets[@]}" | gum choose --header "Pick a network on $dev")" \
      || _bail_to_shell "cancelled at Wi-Fi picker"
    case "$ssid" in
      "Rescan") continue ;;
      "Skip Wi-Fi"*) return 0 ;;
      "Enter SSID manually")
        ssid="$(gum input --placeholder "SSID")" || continue
        [[ -n "$ssid" ]] || continue
        ;;
    esac

    pass="$(gum input --password --placeholder "Password for $ssid (leave blank for open networks)")" || continue

    info "Connecting to '$ssid'…"
    if [[ -n "$pass" ]]; then
      iwctl --passphrase "$pass" station "$dev" connect "$ssid" 2>&1 | tee "$STATE_DIR/wifi.log" || true
    else
      iwctl station "$dev" connect "$ssid" 2>&1 | tee "$STATE_DIR/wifi.log" || true
    fi

    # Give DHCP up to 20 s to hand out a lease.
    for _i in $(seq 1 20); do
      if _has_route; then
        info "Connected — default route via $(ip route show default | head -1)"
        sleep 1
        return 0
      fi
      sleep 1
    done

    warn "Did not get a default route in 20 s. Check the password / SSID and retry."
    gum confirm --default=yes "Try again?" || return 1
  done
}
wifi_step || _bail_to_shell "network required"

# ── step 3: locale (kb + timezone) ─────────────────────────────────
banner
header "Keyboard layout"
KB_LAYOUT="$(printf '%s\n' \
    "us — US English" \
    "gb — UK English" \
    "de — German" \
    "fr — French" \
    "es — Spanish" \
    "it — Italian" \
    "dvorak — Dvorak" \
    "colemak — Colemak" \
    "Other (type layout code)" \
  | gum choose --header "Pick a keyboard layout")" \
  || _bail_to_shell "cancelled at locale"
case "$KB_LAYOUT" in
  "Other"*)
    KB_LAYOUT="$(gum input --placeholder "layout code (e.g. 'us', 'de-nodeadkeys')")" || _bail_to_shell "cancelled"
    ;;
  *) KB_LAYOUT="${KB_LAYOUT%% *}" ;;
esac
[[ -n "$KB_LAYOUT" ]] || KB_LAYOUT="us"
loadkeys "$KB_LAYOUT" >/dev/null 2>&1 || warn "loadkeys $KB_LAYOUT failed — will still write to installed system"

banner
header "Timezone"
TIMEZONE=""
if command -v tzupdate >/dev/null 2>&1; then
  info "Trying to auto-detect timezone from IP…"
  TIMEZONE="$(timeout 6 tzupdate -p 2>/dev/null || true)"
fi
if [[ -z "$TIMEZONE" ]]; then
  TIMEZONE="$(timeout 6 curl -fsS https://ipapi.co/timezone 2>/dev/null || true)"
fi
if [[ -n "$TIMEZONE" ]]; then
  info "Detected timezone: $TIMEZONE"
  gum confirm "Use $TIMEZONE?" || TIMEZONE=""
fi
if [[ -z "$TIMEZONE" ]]; then
  TIMEZONE="$(gum input --placeholder "Timezone (e.g. America/Los_Angeles)" --value "UTC")" \
    || _bail_to_shell "cancelled at locale"
fi
[[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || {
  warn "Zoneinfo /usr/share/zoneinfo/$TIMEZONE is missing — falling back to UTC"
  TIMEZONE="UTC"
}

# ── step 4: disk selection ─────────────────────────────────────────
banner
header "Disk"

mapfile -t candidates < <(
  lsblk -d -n -o NAME,SIZE,MODEL,TRAN 2>/dev/null \
    | awk '$4 != "usb" && $2 != "0B" && $1 !~ /^loop/ && $1 !~ /^sr/ { model=""; for (i=3;i<=NF-1;i++) model=(model?model" ":"")$i; printf "/dev/%s  (%s)  %s\n", $1, $2, model }'
)
if (( ${#candidates[@]} == 0 )); then
  error "No non-USB disks found. Aborting."
  _bail_to_shell "no target disk"
fi

pick=$(printf '%s\n' "${candidates[@]}" \
  | gum choose --header "Which disk should vinOS use? (ALL DATA WILL BE ERASED)") \
  || _bail_to_shell "cancelled at disk"
DISK="${pick%%  *}"

[[ -b "$DISK" ]] || { error "$DISK is not a block device"; _bail_to_shell "invalid disk"; }
mounted=$(lsblk -n -o MOUNTPOINT "$DISK" | awk 'NF' | tr '\n' ' ')
for critical in / /boot /home /efi /boot/efi; do
  if grep -qE "(^| )${critical}( |$)" <<<" $mounted "; then
    error "$DISK has a partition mounted at $critical — this looks like the running system's disk."
    _bail_to_shell "target disk unsafe"
  fi
done

banner
gum style --border double --border-foreground "#E9B872" --padding "1 3" --margin "1 4" \
  "$(printf 'About to WIPE %s' "$DISK")" \
  "$(lsblk "$DISK" -o NAME,SIZE,MODEL 2>/dev/null | sed 's/^/   /')"
gum confirm --default=false "Continue? All data on $DISK will be permanently erased." \
  || _bail_to_shell "cancelled at wipe confirm"

# ── step 5: account ────────────────────────────────────────────────
banner
header "Your account"
while :; do
  USERNAME="$(gum input --placeholder "Username (letters, digits, _-, no spaces)")" \
    || _bail_to_shell "cancelled at username"
  [[ -n "$USERNAME" ]] || { warn "username cannot be empty"; continue; }
  [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || { warn "username must match ^[a-z_][a-z0-9_-]*$"; continue; }
  [[ ${#USERNAME} -le 32 ]] || { warn "username must be 32 chars or fewer"; continue; }
  break
done

while :; do
  p1="$(gum input --password --placeholder "Password for $USERNAME (min 6 chars)")" \
    || _bail_to_shell "cancelled at password"
  p2="$(gum input --password --placeholder "Confirm password")" \
    || _bail_to_shell "cancelled at password"
  [[ -n "$p1" ]] || { warn "password cannot be empty"; continue; }
  [[ ${#p1} -ge 6 ]] || { warn "password must be at least 6 characters"; continue; }
  [[ "$p1" == "$p2" ]] || { warn "passwords did not match"; continue; }
  PASSWORD="$p1"
  unset p1 p2
  break
done

HOSTNAME_="$(gum input --placeholder "Hostname" --value "vinos")" \
  || _bail_to_shell "cancelled at hostname"
[[ -n "$HOSTNAME_" ]] || HOSTNAME_="vinos"

# ── step 6: confirm summary ────────────────────────────────────────
banner
header "Confirm"
gum style --margin "0 4" \
  "  disk:      $DISK" \
  "  user:      $USERNAME" \
  "  hostname:  $HOSTNAME_" \
  "  profile:   $PROFILE" \
  "  keyboard:  $KB_LAYOUT" \
  "  timezone:  $TIMEZONE" \
  "" \
  "Base Arch will pacstrap for ~10-20 min. Then the vinOS overlay runs" \
  "in the chroot. When done, you'll be offered a reboot."

gum confirm --default=false "Start the install?" \
  || _bail_to_shell "cancelled at final confirm"

# ── step 7: run the backend ────────────────────────────────────────
banner
header "Installing vinOS to $DISK"
info "Log tailing at $LOG_FILE. Ctrl-C aborts the install cleanly."
sleep 1

# Pass the password via env var to keep it out of `ps` output.
export VINOS_INSTALL_PASSWORD="$PASSWORD"
unset PASSWORD

set +e
/usr/local/bin/vinos-install-disk-execute \
  --disk "$DISK" \
  --user "$USERNAME" \
  --hostname "$HOSTNAME_" \
  --profile "$PROFILE" \
  --kb-layout "$KB_LAYOUT" \
  --timezone "$TIMEZONE"
rc=$?
set -e
unset VINOS_INSTALL_PASSWORD

if (( rc != 0 )); then
  error "install failed with exit code $rc"
  warn "log preserved at $LOG_FILE"
  _bail_to_shell "install failed"
fi

# ── step 8: reboot prompt ──────────────────────────────────────────
banner
gum style --border double --border-foreground "#7BA7BC" --padding "1 3" --margin "1 4" \
  "Install complete." \
  "" \
  "Press Enter to reboot into your new vinOS install," \
  "or Ctrl-C to drop to a shell."
read -r _ || _bail_to_shell "install done — Enter or 'reboot' to finish"
systemctl reboot
