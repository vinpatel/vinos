#!/usr/bin/env bash
# vinos-install-browser — Chromium (base) + optional alternatives.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=./vinos-install-common
source "$SCRIPT_DIR/vinos-install-common"

bundle_begin "browser" "Chromium (default) + Firefox alt"

bundle_pkg chromium firefox

bundle_end
