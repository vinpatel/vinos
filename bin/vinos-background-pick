#!/usr/bin/env bash
# vinos-background-pick — walker wallpaper picker.
set -euo pipefail
current_link="$HOME/.local/state/vinos/current/theme"
declare -A byname
list=""
if [[ -L "$current_link" ]] && [[ -d "$(readlink -f "$current_link")/backgrounds" ]]; then
  while IFS= read -r -d '' f; do n=$(basename "$f"); byname["$n"]="$f"; list+="$n"$'\n'; done \
    < <(find "$(readlink -f "$current_link")/backgrounds" -maxdepth 1 -type f -print0)
fi
if [[ -d /usr/share/vinos/wallpapers ]]; then
  while IFS= read -r -d '' f; do n=$(basename "$f"); byname["$n"]="$f"; list+="$n"$'\n'; done \
    < <(find /usr/share/vinos/wallpapers -maxdepth 3 -type f -print0)
fi
[[ -n "$list" ]] || { echo "vinos-background-pick: no wallpapers" >&2; exit 1; }
pick=$(printf '%s' "$list" | walker -d -m dmenu -p "Pick a wallpaper…" 2>/dev/null)
[[ -n "$pick" && -n "${byname[$pick]:-}" ]] && exec vinos-background "${byname[$pick]}"
