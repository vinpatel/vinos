#!/usr/bin/env bash
# vinos-upgrade — full system upgrade.
set -euo pipefail
log(){ printf '\033[1;34m▸\033[0m %s\n' "$*"; }
ok(){ printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
log "syncing pacman"; sudo pacman -Sy --noconfirm
log "upgrading system"; sudo pacman -Syu --noconfirm
if command -v yay >/dev/null; then
  log "upgrading AUR"; yay -Syu --noconfirm --answerclean N --answerdiff N || warn "yay non-zero"
fi
# Refresh kernels in /boot from /usr/lib/modules
for kver_dir in /usr/lib/modules/*/; do
  kver="${kver_dir%/}"; kver="${kver##*/}"
  [[ -f "$kver_dir/vmlinuz" ]] || continue
  case "$kver" in
    *-t2)         dst="/boot/vmlinuz-linux-t2" ;;
    *hardened*)   dst="/boot/vmlinuz-linux-hardened" ;;
    *)            dst="/boot/vmlinuz-linux" ;;
  esac
  if [[ ! -f "$dst" ]] || ! cmp -s "$kver_dir/vmlinuz" "$dst"; then
    sudo install -Dm 0644 "$kver_dir/vmlinuz" "$dst"; ok "refreshed $dst"
  fi
done
command -v bootctl >/dev/null && [[ -d /boot/EFI/systemd ]] && sudo bootctl update 2>&1 | grep -Ev 'security hole|world accessible' || true
ok "vinos-upgrade complete"
