#!/usr/bin/env bash
# vinos-install-office — office productivity + mail.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=./vinos-install-common
source "$SCRIPT_DIR/vinos-install-common"

bundle_begin "office" "LibreOffice + Thunderbird"

bundle_pkg libreoffice-fresh thunderbird

bundle_end
