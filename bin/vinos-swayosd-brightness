#!/bin/bash

# vinos:summary=Display brightness level using SwayOSD on the current monitor.
# vinos:args=<0-100>
# vinos:examples=vinos swayosd brightness 0 | vinos swayosd brightness 50 | vinos swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

vinos-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
