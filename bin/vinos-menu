#!/usr/bin/env bash
# vinos-menu — walker/dmenu-style entrypoint for vinOS user actions.
#
# Usage:
#   vinos-menu             top-level swiss-army menu (Super+Alt+Space)
#   vinos-menu capture     screenshot / region / OCR / record / picker
#   vinos-menu toggle      waybar / idle / nightlight / notifications / gaps
#   vinos-menu hardware    audio / bluetooth / wifi / brightness / touchpad
#   vinos-menu system      lock / suspend / logout / reboot / shutdown
#   vinos-menu background  wallpaper picker (delegates to vinos-theme)
#   vinos-menu theme       full theme picker (delegates to vinos-theme --pick)
#   vinos-menu screenrecord start/stop gpu-screen-recorder
#   vinos-menu share       copy path / open dir / send via kdeconnect
#   vinos-menu reminder-set gum-prompted "in N minutes, message"
#
# Chooser preference: walker --dmenu (best), gum choose, fzf, plain
# `select` fallback. Never fails if none installed — falls back to
# printing choices for the user to type.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SUBCMD="${1:-}"

# --- Shared chooser primitives ---------------------------------------

MENU_ITEMS=()
MENU_CMDS=()

_reset() { MENU_ITEMS=(); MENU_CMDS=(); }
add() { MENU_ITEMS+=("$1"); MENU_CMDS+=("$2"); }
have() { command -v "$1" >/dev/null 2>&1; }

_pick_walker() {
  # walker --dmenu inherits the same vinos.css theme as SUPER+SLASH's launcher,
  # so the settings/toggles menu feels visually one with app launch.
  # --placeholder is set per sub-menu when VINOS_MENU_TITLE is exported.
  local args=(--dmenu)
  [[ -n "${VINOS_MENU_TITLE:-}" ]] && args+=(--placeholder "${VINOS_MENU_TITLE}")
  printf '%s\n' "${MENU_ITEMS[@]}" | walker "${args[@]}"
}
_pick_gum()    { printf '%s\n' "${MENU_ITEMS[@]}" | gum choose --limit 1; }
_pick_fzf()    { printf '%s\n' "${MENU_ITEMS[@]}" | fzf; }
_pick_stdin() {
  # List + prompt go to stderr so the caller's `$(...)` capture doesn't
  # eat them. Only the picked item lands on stdout.
  printf '%s\n' "${MENU_ITEMS[@]}" | cat -n >&2
  printf 'pick number: ' >&2
  local n; read -r n
  [[ "$n" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "${MENU_ITEMS[$((n-1))]}"
}

_pick() {
  # Prefer walker only in a graphical session; otherwise gum/fzf/stdin.
  # VINOS_MENU_FORCE_STDIN=1 forces the plain-read fallback — used by
  # the test harness and by any wrapper that needs deterministic I/O.
  if [[ "${VINOS_MENU_FORCE_STDIN:-}" == "1" ]]; then
    _pick_stdin
  elif [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && have walker; then
    _pick_walker
  elif have gum; then
    _pick_gum
  elif have fzf; then
    _pick_fzf
  else
    _pick_stdin
  fi
}

_run() {
  local picked="$1"
  [[ -z "$picked" ]] && return 0
  for i in "${!MENU_ITEMS[@]}"; do
    if [[ "${MENU_ITEMS[$i]}" == "$picked" ]]; then
      case "${MENU_CMDS[$i]}" in
        *vinos-install-*)
          if have foot; then
            exec foot --app-id=org.vinos.install -T "$picked" -- \
              bash -lc "${MENU_CMDS[$i]}; echo; read -p '[enter to close] '"
          else
            exec bash -lc "${MENU_CMDS[$i]}"
          fi
          ;;
        *)
          exec bash -lc "${MENU_CMDS[$i]}"
          ;;
      esac
    fi
  done
}

# --- Sub-menus -------------------------------------------------------

_menu_top() {
  export VINOS_MENU_TITLE="vinOS menu — settings, AI, install…"
  _reset
  # Order by frequency-of-use: the top handful become one-keypress after
  # the menu opens (walker highlights the first match as you type).
  add "  Switch theme"                    "vinos-theme --pick"
  add "  AI chat (vinos-ai)"              "foot --app-id=org.vinos.ai -T 'vinOS AI' -- vinos-ai chat"
  add "  Toggles →"                       "vinos-menu toggle"
  add "󰃟  Display →"                       "vinos-menu display"
  add "  Hardware →"                      "vinos-menu hardware"
  add "  Capture →"                       "vinos-menu capture"
  add "  System →"                        "vinos-menu system"
  add "  Diagnostics (vinos-doctor)"      "foot --app-id=org.vinos.doctor -T 'vinOS doctor' -- vinos-doctor"
  add "  System update"                   "vinos-update"
  add "  Lock screen"                     "vinos-system-lock"
  add "  AI: pull model"                  "foot --app-id=org.vinos.ai -T 'AI pull' -- bash -lc 'read -p \"model: \" m && vinos-ai pull \"\$m\"; read -p enter '"
  add "  AI: status"                      "foot --app-id=org.vinos.ai -T 'AI status' -- bash -lc 'vinos-ai status; read -p enter '"
  local BUNDLES=(ai dev media office gaming productivity comms browser)
  for b in "${BUNDLES[@]}"; do
    add "  Install $b bundle"             "$SCRIPT_DIR/vinos-install-$b"
  done
}

_menu_capture() {
  export VINOS_MENU_TITLE="Capture — screenshot, record, pick color…"
  _reset
  add "  Screenshot (full)"            "vinos-capture-screenshot"
  add "  Screenshot (region)"          "vinos-capture-screenshot region"
  add "  Screen recording"             "vinos-menu screenrecord"
  add "  Color picker"                 "pkill hyprpicker || hyprpicker -a"
  add "  Extract text (OCR)"           "vinos-capture-text-extraction"
}

_menu_ai() {
  # AI-only submenu — bound to the waybar AI pill on-click. Users hit
  # this specifically for AI actions; general system settings are one
  # step back at `vinos-menu` (top-level).
  export VINOS_MENU_TITLE="vinOS AI — chat, models, status…"
  _reset
  add "󰭹  Chat with vinOS AI"            "foot --app-id=org.vinos.ai -T 'vinOS AI' -- vinos-ai chat"
  add "󰋔  AI status"                     "foot --app-id=org.vinos.ai -T 'AI status' -- bash -lc 'vinos-ai status; read -p enter '"
  add "󰇘  Pull model…"                   "foot --app-id=org.vinos.ai -T 'AI pull' -- bash -lc 'read -p \"model: \" m && vinos-ai pull \"\$m\"; read -p enter '"
  add "  Switch model role"             "foot --app-id=org.vinos.ai -T 'AI role' -- bash -lc 'vinos-ai role; read -p enter '"
  add "  Install AI bundle"             "$SCRIPT_DIR/vinos-install-ai"
  add "󰁍  Back to main menu"              "vinos-menu"
}

_menu_toggle() {
  export VINOS_MENU_TITLE="Toggles — bar, idle, blur, gaps…"
  _reset
  add "  Top bar (waybar)"             "vinos-toggle-waybar"
  add "  Idle-lock"                    "vinos-toggle-idle"
  add "  Night light"                  "vinos-toggle-nightlight"
  add "  Notification silence"         "vinos-toggle-notification-silencing"
  add "  Window transparency"          "vinos-hyprland-window-transparency-toggle"
  add "  Window gaps"                  "vinos-hyprland-window-gaps-toggle"
  add "  Single-window aspect"         "vinos-hyprland-window-single-square-aspect-toggle"
  add "  Laptop display"               "vinos-hyprland-monitor-internal toggle"
  add "  Touchpad"                     "vinos-toggle-touchpad"
}

_menu_display() {
  export VINOS_MENU_TITLE="Display — color temperature, wallpaper…"
  _reset
  add "󰃞  Off (identity, 6500 K)"        "vinos-display off"
  add "󰃟  Auto (schedule by time)"       "vinos-display auto"
  add "󰃠  Day (6500 K)"                  "vinos-display day"
  add "󰛨  Warm (4500 K)"                 "vinos-display warm"
  add "󰛨  Reading (3500 K + soft)"       "vinos-display reading"
  add "󰃚  Night (2700 K)"                "vinos-display night"
  add "  Warmer (-500 K)"                "vinos-display warmer"
  add "  Cooler (+500 K)"                "vinos-display cooler"
  add "  Wallpaper picker"               "vinos-theme --pick"
  add "  Live wallpaper cycle (toggle)"  "vinos-toggle-wallpaper-cycle"
  add "  Display status"                 "foot -T 'vinOS display' -- bash -lc 'vinos-display status; read -p enter '"
}

_menu_hardware() {
  export VINOS_MENU_TITLE="Hardware — wifi, bluetooth, audio…"
  _reset
  add "  Wi-Fi"                        "vinos-launch-wifi"
  add "  Bluetooth"                    "vinos-launch-bluetooth"
  add "  Audio mixer"                  "vinos-launch-audio"
  add "  Activity (btop)"              "vinos-launch-tui btop"
  add "  External monitors"            "vinos-hw-external-monitors"
  add "  Hardware report"              "foot --app-id=org.vinos.hw -T 'vinOS hardware' -- bash -lc 'vinos-hw-report; read -p enter '"
}

_menu_system() {
  export VINOS_MENU_TITLE="System — lock, suspend, reboot, shutdown…"
  _reset
  add "  Lock screen"                  "vinos-system-lock"
  add "  Suspend"                      "systemctl suspend"
  add "  Logout Hyprland"              "hyprctl dispatch exit"
  add "  Reboot"                       "systemctl reboot"
  add "  Shutdown"                     "systemctl poweroff"
}

_menu_share() {
  # Share the most recent screenshot / capture from ~/Pictures/screenshots
  local dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
  local latest=""
  [[ -d "$dir" ]] && latest="$(find "$dir" -maxdepth 1 -type f \
    \( -name '*.png' -o -name '*.jpg' -o -name '*.mp4' \) \
    -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"
  _reset
  if [[ -n "$latest" ]]; then
    add "Copy latest capture to clipboard" "wl-copy < '$latest'"
    add "Open latest capture"              "xdg-open '$latest'"
    add "Reveal captures folder"           "xdg-open '$dir'"
  else
    add "No captures yet — open folder"    "xdg-open '$dir' 2>/dev/null || xdg-open '${XDG_PICTURES_DIR:-$HOME/Pictures}'"
  fi
  add "Copy current window title"       "hyprctl activewindow -j | jq -r .title 2>/dev/null | wl-copy"
}

_reminder_set() {
  # Prompt for minutes + message via gum (or plain stdin fallback), then
  # hand off to `vinos-reminder <mins> <message>`.
  local mins="" msg=""
  if have gum; then
    mins="$(gum input --placeholder 'minutes (e.g. 15)' || true)"
    [[ -z "$mins" ]] && exit 0
    msg="$(gum input --placeholder 'message (optional)' || true)"
  else
    printf 'minutes: ' >&2; read -r mins
    [[ -z "$mins" ]] && exit 0
    printf 'message: ' >&2; read -r msg
  fi
  [[ "$mins" =~ ^[0-9]+$ ]] || { printf 'invalid minutes: %s\n' "$mins" >&2; exit 1; }
  if [[ -n "$msg" ]]; then
    exec vinos-reminder "$mins" "$msg"
  else
    exec vinos-reminder "$mins"
  fi
}

_screenrecord_toggle() {
  # Simple start/stop toggle around gpu-screen-recorder writing to
  # ~/Pictures/screenshots/vinos-YYYYmmdd-HHMMSS.mp4. If already running,
  # send SIGINT so gpu-screen-recorder finalises the container cleanly.
  local dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
  mkdir -p "$dir"
  if pgrep -x gpu-screen-recorder >/dev/null 2>&1; then
    pkill -INT -x gpu-screen-recorder
    notify-send -a vinOS "Recording stopped" "Saved to $dir" 2>/dev/null || true
    exit 0
  fi
  local monitor="${VINOS_RECORD_MONITOR:-}"
  if [[ -z "$monitor" ]] && have hyprctl; then
    monitor="$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .name' 2>/dev/null || true)"
  fi
  [[ -z "$monitor" ]] && monitor="screen"
  local out="$dir/vinos-$(date +%Y%m%d-%H%M%S).mp4"
  notify-send -a vinOS "Recording…" "Alt+Print or Super+Shift+5 again to stop" 2>/dev/null || true
  exec gpu-screen-recorder -w "$monitor" -f 60 -o "$out"
}

# --- Dispatch --------------------------------------------------------

case "$SUBCMD" in
  ""|top)         _menu_top ;;
  ai)             _menu_ai ;;
  capture)        _menu_capture ;;
  toggle)         _menu_toggle ;;
  display)        _menu_display ;;
  hardware)       _menu_hardware ;;
  system)         _menu_system ;;
  share)          _menu_share ;;
  background)     exec vinos-theme --pick ;;
  theme)          exec vinos-theme --pick ;;
  screenrecord)   _screenrecord_toggle ;;
  reminder-set)   _reminder_set ;;
  -h|--help|help)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    printf 'vinos-menu: unknown subcommand %q (try --help)\n' "$SUBCMD" >&2
    exit 2
    ;;
esac

_run "$(_pick)"
