#!/usr/bin/env bash
# vinos-hw-report — dump a Markdown-formatted hardware report suitable
# for pasting into a GitHub issue or a HARDWARE.md row.
#
# Usage:
#   vinos-hw-report                  # print to stdout
#   vinos-hw-report --clipboard      # copy to clipboard via wl-copy
#   vinos-hw-report --file report.md # write to file
set -euo pipefail

OUT_MODE="stdout"
OUT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --clipboard|-c) OUT_MODE="clipboard"; shift ;;
    --file)         OUT_MODE="file"; OUT_FILE="$2"; shift 2 ;;
    -h|--help)      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'unknown arg: %s\n' "$1" >&2; exit 2 ;;
  esac
done

_dmi() { cat "/sys/class/dmi/id/$1" 2>/dev/null || printf 'unknown'; }
_cmd() { command -v "$1" >/dev/null 2>&1 && "$@" 2>&1 | head -"${OUTPUT_LINES:-40}" || printf '(%s not installed)' "$1"; }

render() {
  cat <<EOF
## vinOS hardware report — $(date -u +'%Y-%m-%dT%H:%M:%SZ')

### Machine

| Field | Value |
|---|---|
| **Vendor** | $(_dmi sys_vendor) |
| **Model** | $(_dmi product_name) |
| **Version** | $(_dmi product_version) |
| **BIOS** | $(_dmi bios_vendor) $(_dmi bios_version) ($(_dmi bios_date)) |
| **Kernel** | $(uname -r) |
| **vinOS** | $(cat /usr/share/vinos/VERSION 2>/dev/null || echo 'unknown') |

### CPU

\`\`\`
$(lscpu 2>&1 | grep -E 'Model name|Architecture|CPU\(s\)|Vendor' | sed 's/^/  /')
\`\`\`

### GPU / display

\`\`\`
$(lspci 2>&1 | grep -iE 'vga|3d|display' | sed 's/^/  /')
\`\`\`

### Network

\`\`\`
$(lspci 2>&1 | grep -iE 'network|ethernet|wireless' | sed 's/^/  /')
$(ip -brief link 2>&1 | sed 's/^/  /')
\`\`\`

### Audio

\`\`\`
$(lspci 2>&1 | grep -iE 'audio|multimedia' | sed 's/^/  /')
\`\`\`

### Storage

\`\`\`
$(lsblk -d -o NAME,SIZE,MODEL,TRAN,ROTA 2>&1 | sed 's/^/  /')
\`\`\`

### Boot errors (journalctl -b -p err)

\`\`\`
$(journalctl -b -p err --no-pager 2>&1 | tail -20 | sed 's/^/  /')
\`\`\`

### Works out of the box

- [ ] Boot to greeter
- [ ] Internal keyboard
- [ ] Internal trackpad / mouse
- [ ] Wifi
- [ ] Wired ethernet
- [ ] Audio (speakers + mic)
- [ ] Suspend / resume
- [ ] Brightness keys
- [ ] Camera
- [ ] Bluetooth

### Notes

_(describe anything specific to this hardware — quirks, tweaks needed, packages that helped)_

---

Generated by \`vinos-hw-report\` — paste into a GitHub issue at
https://github.com/vinpatel/vinos/issues so we can add a row to
[docs/HARDWARE.md](../../docs/HARDWARE.md).
EOF
}

case "$OUT_MODE" in
  stdout)
    render
    ;;
  clipboard)
    if command -v wl-copy >/dev/null; then
      render | wl-copy
      printf 'copied to clipboard.\n'
    elif command -v xclip >/dev/null; then
      render | xclip -selection clipboard
      printf 'copied to clipboard.\n'
    else
      printf 'no wl-copy or xclip found. Rendering to stdout:\n\n' >&2
      render
    fi
    ;;
  file)
    render > "$OUT_FILE"
    printf 'wrote report → %s\n' "$OUT_FILE"
    ;;
esac
