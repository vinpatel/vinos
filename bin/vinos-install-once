#!/usr/bin/env bash
# vinos-install-once — first-boot bundle offer. Runs from a systemd-user
# unit `vinos-install-once.service` after Hyprland is up. If the sentinel
# ~/.local/state/vinos/install-once.done exists, exit immediately —
# otherwise present the bundle picker, then create the sentinel whether
# the user picks something or dismisses (never re-nag).
set -euo pipefail

STATE_DIR="${HOME}/.local/state/vinos"
SENTINEL="${STATE_DIR}/install-once.done"

mkdir -p "$STATE_DIR"
[[ -f "$SENTINEL" ]] && { echo "vinos-install-once: already ran; exiting."; exit 0; }

# Only run inside a graphical session.
if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
  echo "vinos-install-once: no graphical session yet — deferring."
  exit 0
fi

# Wait up to 20s for walker's service to be registered — Hyprland
# just started, walker autostart may not be ready yet.
for _ in {1..20}; do
  command -v walker >/dev/null && walker --version >/dev/null 2>&1 && break
  sleep 1
done

notify-send -a vinOS \
  "Welcome to vinOS" \
  "Open the menu (Super+Ctrl+O) to add optional bundles (AI, dev, media, gaming, …)." \
  2>/dev/null || true

# Mark done unconditionally so it never nags twice.
touch "$SENTINEL"
