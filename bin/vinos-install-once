#!/usr/bin/env bash
# vinos-install-once — first-boot wrapper. Runs from a Hyprland exec-once
# and (once per user) launches vinos-welcome inside a floating foot
# window. Sentinel at ~/.local/state/vinos/install-once.done prevents
# reruns; delete it (or just run `vinos-welcome`) to reopen.
#
# The persona-overlay contract (/etc/vinos/first-boot.d/<persona>.list)
# is honored by vinos-welcome directly — no preselection work here.
set -euo pipefail

STATE_DIR="${HOME}/.local/state/vinos"
SENTINEL="${STATE_DIR}/install-once.done"

mkdir -p "$STATE_DIR"
[[ -f "$SENTINEL" ]] && { echo "vinos-install-once: already ran; exiting."; exit 0; }

if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
  echo "vinos-install-once: no graphical session yet — deferring."
  exit 0
fi

# Wait for the compositor to be ready enough to launch foot.
for _ in {1..20}; do
  command -v foot >/dev/null && [[ -n "${WAYLAND_DISPLAY:-}" ]] && break
  sleep 1
done

# Launch the flow inside a floating foot terminal. The generic
# org.vinos.* windowrule floats+sizes it. Sentinel written even if
# the user closes early — they can reopen with `vinos-welcome`.
foot --app-id=org.vinos.welcome -T "Welcome to vinOS" \
     -e vinos-welcome || true
touch "$SENTINEL"
