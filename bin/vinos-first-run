#!/usr/bin/env bash
# vinos-first-run — gum-driven post-install wizard (v2, 6 screens).
#
# vinos:summary=Guided welcome + first-boot setup wizard (6 screens)
# vinos:examples=vinos-first-run | vinos-first-run --skip identity | vinos-first-run --reset | vinos-first-run --dry-run
#
# Runs once on the first graphical login (fired by an autostart entry).
# Idempotent — each screen records completion in the state file and skips
# on subsequent runs. Users can re-run any screen with `--skip-done`
# unset or replay the whole wizard with `--reset`.
#
# Screens:
#   1. welcome     — vinOS banner + version + what's coming
#   2. identity    — hostname + git user.name + git user.email
#   3. network     — Wi-Fi status; launch impala if disconnected
#   4. hardware    — T2 detection + prompt; brightness sanity check
#   5. ai          — Ollama service + optional model pull; note on Claude Code login
#   6. bundles     — multi-select installer for ai/dev/media/office/…
#
# State: ~/.local/state/vinos/first-run.json
#   { "started": "<iso8601>",
#     "completed_at": "<iso8601 or null>",
#     "screens": { "welcome": true, "identity": true, … } }

set -euo pipefail

# --- Config + args ----------------------------------------------------

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vinos"
STATE_FILE="$STATE_DIR/first-run.json"
SCREENS=(welcome identity network hardware ai bundles)
BUNDLES=(ai dev media office gaming productivity comms browser)
SKIP=()
DRY_RUN=0
RESET=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip)     SKIP+=("$2"); shift 2 ;;
    --skip=*)   SKIP+=("${1#*=}"); shift ;;
    --reset)    RESET=1; shift ;;
    --dry-run)  DRY_RUN=1; shift ;;
    -h|--help)
      sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) printf 'vinos-first-run: unknown arg %q\n' "$1" >&2; exit 2 ;;
  esac
done

mkdir -p "$STATE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }

# --- State I/O --------------------------------------------------------

_state_init() {
  if [[ $RESET -eq 1 || ! -f "$STATE_FILE" ]]; then
    printf '{"started":"%s","completed_at":null,"screens":{}}\n' \
      "$(date -Iseconds)" >"$STATE_FILE"
  fi
}

_screen_done() {
  local s="$1"
  [[ -f "$STATE_FILE" ]] || return 1
  if have jq; then
    [[ "$(jq -r --arg s "$s" '.screens[$s] // false' "$STATE_FILE")" == "true" ]]
  else
    grep -qE "\"$s\":[[:space:]]*true" "$STATE_FILE"
  fi
}

_mark_done() {
  local s="$1"
  [[ $DRY_RUN -eq 1 ]] && return 0
  if have jq; then
    local tmp; tmp=$(mktemp)
    jq --arg s "$s" '.screens[$s] = true' "$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
  else
    # Fallback: append the key naively. jq is in the base image so this
    # branch is only hit on bootstrap failure.
    printf '{"screens":{"%s":true}}\n' "$s" >>"$STATE_FILE"
  fi
}

_mark_finished() {
  [[ $DRY_RUN -eq 1 ]] && return 0
  if have jq; then
    local tmp; tmp=$(mktemp)
    jq --arg t "$(date -Iseconds)" '.completed_at = $t' "$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
  fi
}

_should_skip() {
  local s="$1"
  for x in "${SKIP[@]:-}"; do
    [[ "$x" == "$s" ]] && return 0
  done
  return 1
}

# --- UI primitives ----------------------------------------------------

_banner() {
  local title="$1" subtitle="${2:-}"
  if have gum; then
    gum style \
      --border double --border-foreground 38 --align center \
      --padding "1 4" --margin "1 0" \
      "$title" "$subtitle"
  else
    printf '\n\033[1;36m== %s ==\033[0m\n%s\n\n' "$title" "$subtitle"
  fi
}

_confirm() {
  local prompt="$1" default="${2:-yes}"
  if have gum; then
    if [[ "$default" == "yes" ]]; then
      gum confirm --default=true "$prompt"
    else
      gum confirm --default=false "$prompt"
    fi
  else
    local reply
    if [[ "$default" == "yes" ]]; then
      read -r -p "$prompt [Y/n] " reply
      [[ ! "$reply" =~ ^[Nn] ]]
    else
      read -r -p "$prompt [y/N] " reply
      [[ "$reply" =~ ^[Yy] ]]
    fi
  fi
}

_input() {
  local prompt="$1" placeholder="${2:-}"
  if have gum; then
    gum input --header "$prompt" --placeholder "$placeholder"
  else
    local reply
    read -r -p "$prompt " reply
    printf '%s' "$reply"
  fi
}

_choose_many() {
  # Args: prompt then each choice. Emits selected choices, one per line.
  local prompt="$1"; shift
  if have gum; then
    printf '%s\n' "$@" | gum choose --no-limit --header "$prompt"
  else
    printf '%s\n' "$prompt" >&2
    local n=1
    for c in "$@"; do printf '%2d. %s\n' "$n" "$c" >&2; n=$((n+1)); done
    read -r -p "enter numbers (space-separated): " reply
    for idx in $reply; do
      [[ "$idx" =~ ^[0-9]+$ ]] || continue
      printf '%s\n' "${@:$idx:1}"
    done
  fi
}

# --- Screen 1: welcome ------------------------------------------------

_scr_welcome() {
  local version="unknown"
  [[ -r /etc/os-release ]] && version="$(. /etc/os-release && printf '%s' "${VERSION_ID:-${VERSION:-unknown}}")"
  _banner "Welcome to vinOS $version" \
    "Agentic Linux for developers · Hyprland · walker · vinos-menu (Super+Alt+Space)"
  cat <<TXT
This wizard will walk you through 6 quick screens:

  1. Welcome            (this)
  2. Identity           hostname + git identity
  3. Network            wi-fi, if not already up
  4. Hardware           Apple T2 kernel, brightness support
  5. AI                 Ollama service + optional model download
  6. Bundles            optional installer bundles (ai, dev, media, …)

You can skip any screen with '--skip <name>' or replay the whole
wizard with 'vinos-first-run --reset' later.

TXT
  _confirm "Ready to begin?" yes
}

# --- Screen 2: identity ------------------------------------------------

_scr_identity() {
  _banner "Identity" "hostname + git config"
  local cur_host
  cur_host="$(hostnamectl --static 2>/dev/null || hostname 2>/dev/null || printf 'vinos')"
  printf 'Current hostname: \033[1m%s\033[0m\n' "$cur_host"
  local new_host
  new_host="$(_input "Set hostname (blank to keep '$cur_host'):" 'e.g. vinos-t2')"
  if [[ -n "$new_host" && "$new_host" != "$cur_host" ]]; then
    if [[ $DRY_RUN -eq 1 ]]; then
      printf '[dry-run] would run: sudo hostnamectl set-hostname %q\n' "$new_host"
    else
      sudo hostnamectl set-hostname "$new_host" || \
        printf 'hostnamectl failed — set /etc/hostname manually later.\n' >&2
    fi
  fi

  if have git; then
    local cur_name cur_email
    cur_name="$(git config --global --get user.name 2>/dev/null || printf '')"
    cur_email="$(git config --global --get user.email 2>/dev/null || printf '')"
    if [[ -z "$cur_name" ]]; then
      local n; n="$(_input 'Git user.name (blank to skip):' 'Full Name')"
      if [[ -n "$n" ]]; then
        [[ $DRY_RUN -eq 1 ]] || git config --global user.name "$n"
      fi
    else
      printf 'Git user.name already set: %s\n' "$cur_name"
    fi
    if [[ -z "$cur_email" ]]; then
      local e; e="$(_input 'Git user.email (blank to skip):' 'you@example.com')"
      if [[ -n "$e" ]]; then
        [[ $DRY_RUN -eq 1 ]] || git config --global user.email "$e"
      fi
    else
      printf 'Git user.email already set: %s\n' "$cur_email"
    fi
  fi
}

# --- Screen 3: network -------------------------------------------------

_scr_network() {
  _banner "Network" "check wi-fi / launch impala if not connected"
  local up=0
  if have nmcli && nmcli -t -f STATE g 2>/dev/null | grep -q '^connected'; then up=1; fi
  if [[ $up -eq 0 ]] && ip -brief route 2>/dev/null | grep -q '^default'; then up=1; fi

  if [[ $up -eq 1 ]]; then
    printf '\033[1;32m✓\033[0m Network is up.\n'
    return 0
  fi
  printf '\033[1;33m✗\033[0m No default route detected.\n'
  if have vinos-launch-wifi && _confirm 'Launch Wi-Fi picker (impala) now?' yes; then
    [[ $DRY_RUN -eq 1 ]] || vinos-launch-wifi
  else
    printf 'Skipping. You can launch it later with Super+Ctrl+W or `vinos-launch-wifi`.\n'
  fi
}

# --- Screen 4: hardware ------------------------------------------------

_scr_hardware() {
  _banner "Hardware" "Apple T2 kernel + brightness sanity"
  local vendor="unknown"
  [[ -r /sys/class/dmi/id/sys_vendor ]] && vendor="$(cat /sys/class/dmi/id/sys_vendor)"
  printf 'Detected vendor: \033[1m%s\033[0m\n' "$vendor"

  if [[ "$vendor" == "Apple Inc." ]] \
     && [[ ! -f /var/lib/vinos/t2-enable.done ]] \
     && have vinos-t2-enable; then
    printf '\nApple T2 Mac detected — the linux-t2 kernel + firmware are required\n'
    printf 'for keyboard, trackpad, Wi-Fi, audio, Touch Bar, and thermal.\n\n'
    if _confirm 'Enable T2 support now? (reboots when done)' yes; then
      [[ $DRY_RUN -eq 1 ]] || vinos-t2-enable --yes
    else
      printf 'Skipping. Run `sudo vinos-t2-enable` later when ready.\n'
    fi
  else
    printf 'Nothing to do here — hardware is already supported by the base kernel.\n'
  fi

  # Sanity check: brightness sysfs available (helps users spot broken GPU perms).
  if [[ -d /sys/class/backlight ]] && ls /sys/class/backlight/ 2>/dev/null | grep -q .; then
    printf '\033[1;32m✓\033[0m Backlight sysfs present.\n'
  else
    printf '\033[1;33m⚠\033[0m No backlight sysfs entries — brightness keys may no-op.\n'
  fi
}

# --- Screen 5: AI ------------------------------------------------------

_scr_ai() {
  _banner "AI" "Ollama + optional model pull · Claude Code note"
  if have ollama; then
    if systemctl is-active --quiet ollama.service 2>/dev/null; then
      printf '\033[1;32m✓\033[0m Ollama service is running.\n'
    else
      if _confirm 'Enable + start ollama.service?' yes; then
        [[ $DRY_RUN -eq 1 ]] || sudo systemctl enable --now ollama.service
      fi
    fi
    if _confirm 'Download a starter model now? (Qwen3-Coder 30B — ~18 GB)' no; then
      if [[ $DRY_RUN -eq 1 ]]; then
        printf '[dry-run] would run: ollama pull qwen3-coder:30b\n'
      else
        ollama pull qwen3-coder:30b || \
          printf 'ollama pull failed — you can retry later with `ollama pull qwen3-coder:30b`\n' >&2
      fi
    fi
  else
    printf 'ollama is not installed. Install it later with `pacman -S ollama`.\n'
  fi

  if have claude; then
    printf '\n\033[1;36mNote:\033[0m Claude Code is installed. Run `claude` in a terminal\n'
    printf 'to log in. Your session settings live at ~/.claude/settings.json.\n'
  fi
  if have vinos-mcp; then
    printf '\n\033[1;32m✓\033[0m vinos-mcp curated registry available — try `vinos-mcp list`.\n'
  fi
}

# --- Screen 6: bundles -------------------------------------------------

_scr_bundles() {
  _banner "Bundles" "optional installers — pick any / none"
  local picks
  # Space-separated set for the prompt; readarray handles the newline
  # output from gum choose --no-limit.
  mapfile -t picks < <(_choose_many 'Select bundles to install (Tab = mark, Enter = confirm)' "${BUNDLES[@]}") || true
  if [[ ${#picks[@]} -eq 0 ]]; then
    printf 'No bundles selected.\n'
    return 0
  fi
  printf 'Will install: %s\n' "${picks[*]}"
  local b installer
  for b in "${picks[@]}"; do
    installer="vinos-install-$b"
    if ! have "$installer"; then
      printf '  \033[1;33m⚠\033[0m %s not found — skipping\n' "$installer"
      continue
    fi
    if [[ $DRY_RUN -eq 1 ]]; then
      printf '  [dry-run] would run: %s\n' "$installer"
    else
      printf '\n\033[1;34m▸\033[0m running %s …\n' "$installer"
      "$installer" || printf '  \033[1;31m✗\033[0m %s failed — check output above\n' "$installer"
    fi
  done
}

# --- Main dispatch ----------------------------------------------------

_state_init

# Silent no-op on second and later logins so autostart doesn't flash
# a terminal every Hyprland session. Only skip when completed_at is
# set AND no --skip was requested (skip means user wants targeted
# replay of a screen).
if [[ -f "$STATE_FILE" ]] \
   && [[ ${#SKIP[@]} -eq 0 ]] \
   && [[ $RESET -eq 0 ]] \
   && have jq \
   && [[ "$(jq -r '.completed_at // "null"' "$STATE_FILE" 2>/dev/null)" != "null" ]]; then
  exit 0
fi

for s in "${SCREENS[@]}"; do
  if _should_skip "$s"; then
    printf '\033[2m-- skipping %s (per --skip) --\033[0m\n' "$s"
    continue
  fi
  if _screen_done "$s"; then
    printf '\033[2m-- %s already done --\033[0m\n' "$s"
    continue
  fi
  case "$s" in
    welcome)   _scr_welcome && _mark_done welcome ;;
    identity)  _scr_identity && _mark_done identity ;;
    network)   _scr_network && _mark_done network ;;
    hardware)  _scr_hardware && _mark_done hardware ;;
    ai)        _scr_ai && _mark_done ai ;;
    bundles)   _scr_bundles && _mark_done bundles ;;
  esac
done

_mark_finished

# Legacy: the sudoers first-run drop was previously stripped here. Kept
# behind a file-existence guard so old ISOs still clean up correctly.
if [[ -f /etc/sudoers.d/first-run ]]; then
  [[ $DRY_RUN -eq 1 ]] || sudo rm -f /etc/sudoers.d/first-run || true
fi

printf '\n\033[1;32m✓\033[0m vinos-first-run complete.\n'
printf 'Re-run any time with: vinos-first-run --reset\n'
