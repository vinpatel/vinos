#!/usr/bin/env bash
# vinos-toggle-screensaver — toggle hypridle.
set -euo pipefail
if pidof hypridle >/dev/null; then
  pkill hypridle
  command -v notify-send >/dev/null && notify-send -a vinos "vinOS" "Screensaver OFF"
else
  hypridle >/dev/null 2>&1 & disown
  command -v notify-send >/dev/null && notify-send -a vinos "vinOS" "Screensaver ON"
fi
