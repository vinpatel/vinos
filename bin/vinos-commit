#!/usr/bin/env bash
# vinos-commit — AI-drafted commit message from your staged diff.
#
# Usage:
#   vinos-commit                     Draft, then Edit/Accept/Retry/Quit
#   vinos-commit -y                  Accept the draft without prompting
#   vinos-commit --kind fix|feat|refactor|docs|chore|test|perf
#                                    Bias the draft toward a conventional prefix
#   vinos-commit -h | --help         This help
#
# Reads `git diff --cached`. If nothing is staged, tells you to run
# git add first. Force local model with:
#   VINOS_ROUTE=ollama vinos-commit

set -euo pipefail

if [[ -t 1 ]]; then B=$'\033[1;34m'; R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; D=$'\033[2m'; Z=$'\033[0m'
else                B=''            R=''            G=''            Y=''            D=''            Z=''
fi
_die()  { printf '%svinos-commit:%s %s\n' "$R" "$Z" "$*" >&2; exit 1; }
_log()  { printf '%svinos-commit:%s %s\n' "$B" "$Z" "$*"; }
_have() { command -v "$1" >/dev/null 2>&1; }

AUTO_ACCEPT=0
KIND=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)   AUTO_ACCEPT=1; shift ;;
    --kind)     [[ $# -ge 2 ]] || _die "--kind needs a value"
                KIND="$2"; shift 2 ;;
    -h|--help)  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)          _die "unknown arg: $1 (try --help)" ;;
  esac
done

_have git      || _die "git not installed"
_have vinos-ai || _die "vinos-ai not found in PATH"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || _die "not inside a git repo"

diff=$(git diff --cached 2>/dev/null || true)
if [[ -z "$diff" ]]; then
  _die "nothing staged; run git add first"
fi

# Cap the diff we send to keep the model input reasonable (~200KB).
diff_trimmed=$(printf '%s' "$diff" | head -c 200000)

kind_hint=""
case "$KIND" in
  "")                                    ;;
  fix|feat|refactor|docs|chore|test|perf)
    kind_hint="Bias the subject toward a '${KIND}:' prefix." ;;
  *) _die "invalid --kind: $KIND (fix|feat|refactor|docs|chore|test|perf)" ;;
esac

files=$(git diff --cached --name-only | head -20)

prompt="You are writing a concise git commit message from the staged diff.

Rules:
- First line: imperative subject, ~60 chars max, no trailing period.
- Optional body: wrapped at ~72 chars, only if the change needs a 'why'.
- No preamble. No markdown fences. Output ONLY the commit message text.
- ${kind_hint:-Use a natural imperative verb; no conventional-commit prefix required.}

Files touched:
$files

--- STAGED DIFF ---
$diff_trimmed"

_draft() {
  _log "drafting commit message"
  vinos-ai chat "$prompt" 2>/dev/null | sed -e '/^$/N;/^\n$/D' | awk 'NF || printed {printed=1; print}'
}

_confirm_and_commit() {
  local msg="$1"
  # Write to a tempfile so multi-line messages survive.
  local tmp; tmp=$(mktemp -t vinos-commit.XXXXXX.msg)
  printf '%s\n' "$msg" > "$tmp"
  trap 'rm -f "$tmp"' RETURN
  git commit -F "$tmp"
}

msg=$(_draft) || _die "vinos-ai returned no output"
[[ -n "$msg" ]] || _die "empty draft"

if (( AUTO_ACCEPT )); then
  _log "accepting draft (-y)"
  _confirm_and_commit "$msg"
  exit 0
fi

while true; do
  printf '\n%s--- draft ---%s\n%s\n%s-------------%s\n' "$D" "$Z" "$msg" "$D" "$Z"
  printf '%s[E]dit / [A]ccept / [R]etry / [Q]uit%s ? ' "$B" "$Z"
  read -r choice </dev/tty || choice="q"
  case "${choice,,}" in
    a|"")
      _confirm_and_commit "$msg"; exit 0 ;;
    e)
      tmp=$(mktemp -t vinos-commit.XXXXXX.msg)
      printf '%s\n' "$msg" > "$tmp"
      "${EDITOR:-nano}" "$tmp"
      msg=$(<"$tmp"); rm -f "$tmp"
      [[ -n "$msg" ]] || { _log "empty after edit, aborting"; exit 1; }
      _confirm_and_commit "$msg"; exit 0 ;;
    r)
      _log "retrying"
      msg=$(_draft) || _die "vinos-ai returned no output"
      [[ -n "$msg" ]] || _die "empty draft" ;;
    q)
      _log "quit — nothing committed"; exit 0 ;;
    *)
      printf '%schoose e / a / r / q%s\n' "$Y" "$Z" ;;
  esac
done
