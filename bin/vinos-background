#!/usr/bin/env bash
# vinos-background — set a wallpaper file as desktop background.
set -euo pipefail
wp="${1:-}"
[[ -f "$wp" ]] || { echo "usage: vinos-background <path-to-image>" >&2; exit 1; }
mkdir -p "$HOME/.config/vinos"
cp -f "$wp" "$HOME/.config/vinos/wallpaper.png"
if command -v hyprctl >/dev/null; then
  hyprctl hyprpaper unload all >/dev/null 2>&1 || true
  hyprctl hyprpaper preload "$HOME/.config/vinos/wallpaper.png" >/dev/null 2>&1 || true
  hyprctl hyprpaper wallpaper ,"$HOME/.config/vinos/wallpaper.png" >/dev/null 2>&1 || true
fi
echo "vinos-background: set to $wp"
