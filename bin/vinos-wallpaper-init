#!/usr/bin/env bash
# vinos-wallpaper-init — start awww-daemon (Wayland wallpaper daemon,
# formerly swww) and apply the vinOS wallpaper once the daemon socket
# is ready. Called from hyprland.conf's exec-once as the single source
# of truth for cold-start wallpaper.
#
# The previous `awww-daemon &  sleep 0.3; awww img …` pattern raced on
# slow boots — 300ms wasn't always enough for the daemon socket to
# bind, and `awww img` would exit non-zero and leave the compositor
# on its default black clear-color.
#
# Idempotent: safe to re-run (awww-daemon replies "already running"
# on the second call; `awww img` just re-applies).
set -eu

WALLPAPER="${1:-/usr/share/vinos/wallpaper.png}"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/vinos/awww-init.log"
mkdir -p "$(dirname "$LOG")"

exec >>"$LOG" 2>&1
printf '\n=== %s: init wallpaper=%s ===\n' "$(date -Is)" "$WALLPAPER"

if ! command -v awww-daemon >/dev/null; then
  echo "awww-daemon not installed — no wallpaper support"
  exit 0
fi

# Start the daemon if it's not already up. `awww query` returns 0 iff
# the socket is bound and answering.
if ! awww query >/dev/null 2>&1; then
  echo "starting awww-daemon"
  awww-daemon >>"$LOG" 2>&1 &
fi

# Wait up to 5s for the socket. Backoff 100ms.
for _ in $(seq 1 50); do
  awww query >/dev/null 2>&1 && break
  sleep 0.1
done

if ! awww query >/dev/null 2>&1; then
  echo "awww-daemon did not become ready within 5s — giving up"
  exit 1
fi

echo "applying wallpaper: $WALLPAPER"
awww img "$WALLPAPER" --transition-type none
echo "done"
