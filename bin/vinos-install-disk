#!/usr/bin/env bash
# vinos-install-disk — kept as a familiar entry point that delegates to
# the phased installer at /usr/local/bin/vinos-install (which the systemd
# unit vinos-installer.service runs on tty1 for install boot entries).
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  exec sudo -E /usr/local/bin/vinos-install "$@"
fi
exec /usr/local/bin/vinos-install "$@"
