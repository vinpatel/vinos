#!/usr/bin/env bash
# vinos-install-disk — one-command installer from the live vinOS ISO
# to a disk. Wraps archinstall with a hardware-aware preset profile,
# then chroot-runs install.sh to layer vinOS on top.
#
# Usage:
#   sudo vinos-install-disk                                         # interactive
#   sudo vinos-install-disk --disk /dev/nvme0n1 --user vin \
#                           --password 'hunter2' --hostname mbp --yes
#
# What it does:
#   1. Detects hardware (Apple T2 / NVIDIA / generic) and picks the
#      right archinstall profile template.
#   2. Prompts for disk / username / password / hostname (interactive),
#      or takes them from flags (non-interactive).
#   3. Renders the archinstall JSON with the answers (chmod 600 — the
#      password lives in plaintext until the temp dir is deleted on
#      exit).
#   4. Runs `archinstall --config <rendered.json> --silent`.
#   5. arch-chroots into /mnt and clones this repo + runs install.sh,
#      writes /etc/sudoers.d/10-vinos-wheel with password-required
#      wheel, disables sshd by default.
#   6. Configures bootloader for the hardware class.
#   7. Prompts to reboot (or does immediately with --reboot).
#
# Must run as root (partition + pacstrap + chroot). Requires the live
# ISO's shipped `archinstall`, `gum`, and network.

set -euo pipefail

VINOS_PROFILE_DIR="${VINOS_PROFILE_DIR:-/usr/share/vinos/archinstall}"
VINOS_REPO_URL="${VINOS_REPO_URL:-https://github.com/vinpatel/vinos.git}"
VINOS_BRANCH="${VINOS_BRANCH:-main}"

DISK=""
USERNAME=""
HOSTNAME="vinos"
YES=0
REBOOT=0
PROFILE=""  # override auto-detect
KEEP_TMP=0
DRY_RUN=0
PASSWORD=""   # set via --password or gum prompt; must not remain empty
              # on the installed system (see BLOCKER-1 in QA notes).

die()  { printf '\033[1;31m[vinos-install-disk] FAIL:\033[0m %s\n' "$*" >&2; exit 1; }
log()  { printf '\033[1;34m[vinos-install-disk]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[vinos-install-disk] WARN:\033[0m %s\n' "$*" >&2; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --disk)      DISK="$2";     shift 2 ;;
    --user)      USERNAME="$2"; shift 2 ;;
    --password)  PASSWORD="$2"; shift 2 ;;
    --hostname)  HOSTNAME="$2"; shift 2 ;;
    --profile)   PROFILE="$2";  shift 2 ;;
    --yes|-y)    YES=1;   shift ;;
    --reboot)    REBOOT=1; shift ;;
    --keep-tmp)  KEEP_TMP=1; shift ;;
    --dry-run|-n) DRY_RUN=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

if (( DRY_RUN == 0 )); then
  [[ $EUID -eq 0 ]] || die "must run as root (partitioning + pacstrap). Add --dry-run to preview without root."
fi

# ── Hardware detection ──────────────────────────────────────────────
detect_profile() {
  local vendor
  vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || printf '')"

  if [[ "$vendor" == "Apple Inc." ]]; then
    echo "t2mac"
    return
  fi

  if lspci 2>/dev/null | grep -qi 'nvidia'; then
    # Discrete NVIDIA needs different kernel modules + configs at
    # install time. Hybrid laptops still get the NVIDIA profile — the
    # Intel/AMD side gets picked up too.
    echo "nvidia"
    return
  fi

  echo "generic"
}

if [[ -z "$PROFILE" ]]; then
  PROFILE=$(detect_profile)
  log "detected profile: $PROFILE"
else
  log "using forced profile: $PROFILE"
fi

TEMPLATE="$VINOS_PROFILE_DIR/${PROFILE}.json"
[[ -f "$TEMPLATE" ]] || die "profile template missing: $TEMPLATE"

# ── Interactive prompts (gum if available; stdin fallback) ──────────
_pick_disk() {
  # List block devices with sensible defaults; refuse USB unless user
  # picks it (that's the boot USB).
  mapfile -t candidates < <(lsblk -d -n -o NAME,SIZE,MODEL,TRAN 2>/dev/null \
    | awk '$4 != "usb" && $2 != "0B" {print "/dev/"$1"  "$2"  "$3}')
  (( ${#candidates[@]} > 0 )) || die "no non-USB disks found"

  if command -v gum >/dev/null 2>&1; then
    picked=$(printf '%s\n' "${candidates[@]}" | gum choose --header "Which disk should vinOS use? (ALL DATA WILL BE ERASED)")
  else
    printf 'Available disks:\n'
    printf '  %s\n' "${candidates[@]}"
    printf 'Type the FULL device path (e.g. /dev/nvme0n1): '
    read -r picked
  fi
  DISK="${picked%%  *}"
  DISK="${DISK// /}"
}

if [[ -z "$DISK" ]]; then _pick_disk; fi

[[ -b "$DISK" ]] || die "$DISK is not a block device"

# Refuse mounted disks (safety).
mounted=$(lsblk -n -o MOUNTPOINT "$DISK" | awk 'NF' | tr '\n' ' ')
for critical in / /boot /home /efi /boot/efi; do
  grep -qE "(^| )${critical}( |$)" <<<" $mounted " && \
    die "$DISK has a partition mounted at $critical — this is the running system's disk"
done

# Confirm the wipe.
if (( YES == 0 )); then
  size=$(lsblk -d -n -o SIZE "$DISK")
  model=$(lsblk -d -n -o MODEL "$DISK" | awk '{$1=$1;print}')
  printf '\n\033[1;31mAbout to WIPE %s (%s %s) and install vinOS.\033[0m\n' "$DISK" "$size" "$model"
  if command -v gum >/dev/null 2>&1; then
    gum confirm --default=false "Continue?" || die "aborted."
  else
    printf 'Type YES to continue: '
    read -r conf
    [[ "$conf" == "YES" ]] || die "aborted."
  fi
fi

# ── Username for the installed user ────────────────────────────────
# No hardcoded default — the user picks their own account name.
if [[ -z "$USERNAME" ]]; then
  if (( YES == 1 )); then
    die "--yes requires --user (no default username; you must pick one)"
  fi
  while :; do
    if command -v gum >/dev/null 2>&1; then
      USERNAME=$(gum input --placeholder "Username for your account (letters, digits, _-, no spaces)")
    else
      printf 'Username for your account: '
      read -r USERNAME
    fi
    [[ -n "$USERNAME" ]] || { warn "username cannot be empty"; continue; }
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || { warn "username must match ^[a-z_][a-z0-9_-]*$ (lowercase start, no spaces)"; continue; }
    [[ ${#USERNAME} -le 32 ]] || { warn "username must be 32 chars or fewer"; continue; }
    break
  done
fi

# ── Password for the installed user ────────────────────────────────
# Prompt now so the plaintext password never persists past the trap
# that rm -rf $TMPDIR later. --yes without --password refuses to
# proceed — we never ship a distributable image with an empty pw.
if [[ -z "$PASSWORD" ]]; then
  if (( YES == 1 )); then
    die "--yes requires --password (empty passwords are refused on installed systems)"
  fi
  while :; do
    if command -v gum >/dev/null 2>&1; then
      p1=$(gum input --password --placeholder "Password for user $USERNAME")
      p2=$(gum input --password --placeholder "Confirm password")
    else
      printf 'Password for %s: ' "$USERNAME"; stty -echo; read -r p1; stty echo; printf '\n'
      printf 'Confirm: ';                       stty -echo; read -r p2; stty echo; printf '\n'
    fi
    [[ -n "$p1" ]] || { warn "password cannot be empty"; continue; }
    [[ ${#p1} -ge 6 ]] || { warn "password must be at least 6 characters"; continue; }
    [[ "$p1" == "$p2" ]] || { warn "passwords did not match"; continue; }
    PASSWORD="$p1"
    unset p1 p2
    break
  done
fi

# ── Render the archinstall JSON with the answers ────────────────────
TMPDIR=$(mktemp -d)
trap '[[ $KEEP_TMP -eq 0 ]] && rm -rf "$TMPDIR"' EXIT

RENDERED="$TMPDIR/archinstall.json"
# JSON-escape the password so `"` / `\` / control chars don't break parsing.
# python is guaranteed on the live ISO (archinstall drags it in).
PW_JSON=$(printf '%s' "$PASSWORD" | python -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read())[1:-1])')
sed \
  -e "s|@@DISK@@|$DISK|g" \
  -e "s|@@USER@@|$USERNAME|g" \
  -e "s|@@HOSTNAME@@|$HOSTNAME|g" \
  -e "s|@@PASSWORD@@|$PW_JSON|g" \
  "$TEMPLATE" > "$RENDERED"
chmod 0600 "$RENDERED"  # plaintext password — keep out of world-read

log "rendered archinstall config → $RENDERED"

if (( DRY_RUN )); then
  log "DRY RUN — no changes made. Rendered archinstall config (password redacted):"
  sed 's/"!password": *"[^"]*"/"!password": "***REDACTED***"/' "$RENDERED"
  log "would run:  archinstall --config $RENDERED --silent"
  log "would then: arch-chroot /mnt to clone $VINOS_REPO_URL + run install.sh"
  KEEP_TMP=1
  exit 0
fi

# ── Run archinstall ─────────────────────────────────────────────────
command -v archinstall >/dev/null || die "archinstall not found (should ship in the live ISO)"

log "running archinstall (silent) — this may take 10-20 min for base Arch"
if ! archinstall --config "$RENDERED" --silent; then
  die "archinstall failed. Config kept at $RENDERED for inspection."
fi

# ── Layer vinOS via install.sh in the chroot ────────────────────────
log "base Arch installed. Layering vinOS…"

# archinstall mounted the new root at /mnt.
[[ -d /mnt/etc ]] || die "/mnt is not a mounted new root — archinstall didn't finish?"

arch-chroot /mnt bash -euo pipefail <<CHROOT_EOF
# Clone the vinOS repo as the newly-created user, then run install.sh.
export HOME=/home/${USERNAME}
sudo -u ${USERNAME} -H bash -c "
  git clone --depth=1 --branch ${VINOS_BRANCH} ${VINOS_REPO_URL} \\
    /home/${USERNAME}/.local/share/vinos
  cd /home/${USERNAME}/.local/share/vinos
  # Skip 04-services — archinstall handles service enablement its own way
  # (systemd-networkd vs iwd choice), and we don't want to fight it here.
  # vinos-update post-boot will apply the full stack.
  VINOS_INSTALL_ASSUME_YES=1 ./install.sh
"

# Enable the first-boot hw-detect service. Runs 06-hardware.sh once
# before graphical.target so drivers land automatically pre-login.
systemctl enable vinos-firstboot.service 2>/dev/null || true

# Password-required wheel sudoers on the INSTALLED system. The live
# ISO's NOPASSWD file lives only in the airootfs overlay and does not
# propagate to /mnt (see iso/airootfs-overlay/etc/sudoers.d/10-vinos-wheel).
install -Dm 0440 /dev/stdin /etc/sudoers.d/10-vinos-wheel <<'SUDO'
# vinOS installed-system sudoers policy.
# wheel members can sudo, but must authenticate. Do not add NOPASSWD.
%wheel ALL=(ALL:ALL) ALL
SUDO
visudo -cf /etc/sudoers.d/10-vinos-wheel >/dev/null || {
  echo "vinos-install-disk: sudoers.d/10-vinos-wheel failed visudo check" >&2
  exit 1
}

# sshd defaults to disabled on the installed system too — flip on with
# systemctl enable --now sshd if the user wants it. Keeps parity with
# live ISO posture.
systemctl disable sshd.service 2>/dev/null || true
CHROOT_EOF

# ── Profile-specific bootloader tweaks ──────────────────────────────
# T2 kernel + firmware install deferred to vinos-t2-enable (post-boot).
# Rationale: pacstrap can't resolve linux-t2 unless [arch-mact2] is
# registered in the target chroot's pacman.conf, and the live ISO's
# pacman.conf inherits nothing about it. Base install stays on stock
# `linux` (guaranteed to succeed); vinos-first-run detects Apple
# hardware on first login and offers to run vinos-t2-enable, which
# registers [arch-mact2], installs the T2 kernel + firmware, rewrites
# the systemd-boot entry, and reboots into the T2 kernel.
case "$PROFILE" in
  t2mac)
    log "T2 Mac: base install uses stock 'linux' kernel"
    log "        T2 support enabled post-boot via 'sudo vinos-t2-enable'"
    log "        (vinos-first-run prompts automatically on first login)"
    ;;
esac

# ── Finish ─────────────────────────────────────────────────────────
log "vinOS install complete."
log ""
log "  disk:     $DISK"
log "  user:     $USERNAME  (password set)"
log "  hostname: $HOSTNAME"
log "  profile:  $PROFILE"
log "  sudo:     wheel members must authenticate (installed-system default)"
log "  ssh:      disabled by default — 'systemctl enable --now sshd' to turn on"
log ""

if (( REBOOT )); then
  log "rebooting in 5s (Ctrl-C to cancel)…"
  sleep 5
  systemctl reboot
elif (( YES == 0 )); then
  if command -v gum >/dev/null 2>&1; then
    gum confirm "Reboot into your new vinOS install now?" && systemctl reboot
  else
    printf 'Reboot now? [y/N] '; read -r r
    [[ "$r" =~ ^[Yy] ]] && systemctl reboot
  fi
fi
