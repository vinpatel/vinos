#!/usr/bin/env bash
# vinos-launch-wifi — open the impala TUI in a floating terminal for
# quick wifi connect/disconnect. rfkill unblocks the radio first
# (Chromebook/Mac quirk), then impala runs inside foot with a
# well-known app-id so the Hyprland window rule can float it.
set -euo pipefail

rfkill unblock wifi 2>/dev/null || true

# Prefer foot (waybar terminal), fall back to alacritty. `--app-id`
# lets the Hyprland windowrule target this specific window.
if command -v foot >/dev/null 2>&1; then
  exec foot --app-id=org.vinos.impala -T "vinOS wifi" -- impala
elif command -v alacritty >/dev/null 2>&1; then
  exec alacritty --class org.vinos.impala,org.vinos.impala -T "vinOS wifi" -e impala
else
  exec xterm -class org.vinos.impala -T "vinOS wifi" -e impala
fi
