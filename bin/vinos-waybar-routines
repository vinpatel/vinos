#!/usr/bin/env bash
# vinos-waybar-routines — waybar custom module JSON.
# Shows: <active> live · <next> next
# Where <next> is the countdown to the next scheduled routine.

set -euo pipefail

STATE_DIR="${VINOS_ROUTINES_STATE:-$HOME/.vinos/routines/state}"
ROUTINES_DIR="${VINOS_ROUTINES_USER:-$HOME/.vinos/routines}"
SYS_DIR="${VINOS_ROUTINES_SYS:-/etc/vinos/routines}"

# ─── Active routines ───
ACTIVE=0
if [[ -d "$STATE_DIR" ]]; then
  for pid_file in "$STATE_DIR"/*/current.pid; do
    [[ -f "$pid_file" ]] || continue
    pid=$(cat "$pid_file" 2>/dev/null || echo)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      ACTIVE=$((ACTIVE + 1))
    fi
  done
fi

# ─── Count total configured routines ───
TOTAL=0
for dir in "$ROUTINES_DIR" "$SYS_DIR"; do
  [[ -d "$dir" ]] || continue
  for toml in "$dir"/*.toml; do
    [[ -f "$toml" ]] || continue
    TOTAL=$((TOTAL + 1))
  done
done

# ─── Class + text ───
CLASS="idle"
if (( ACTIVE > 0 )); then
  CLASS="active"
  TEXT="${ACTIVE} live"
elif (( TOTAL == 0 )); then
  TEXT="0"
else
  TEXT="${TOTAL}"
fi

TOOLTIP="Routines: ${ACTIVE} live · ${TOTAL} configured\nClick: list · Right-click: menu"

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$TEXT" "$TOOLTIP" "$CLASS"
