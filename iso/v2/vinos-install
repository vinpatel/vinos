#!/usr/bin/env bash
# /usr/local/bin/vinos-install
#
# The vinOS 2.0 installer wrapper. Runs Omarchy's installer against the
# target disk, then applies vinOS post-install overlays (security + mac + brand).
#
# Intended to be run from the vinOS 2.0 live ISO. Not idempotent — installs
# a fresh system.
set -euo pipefail

log()  { printf '\033[1;34m[vinos-install]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[vinos-install] FAIL:\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[1;33m[vinos-install]\033[0m %s\n' "$*" >&2; }

[[ $EUID -eq 0 ]] || die "run as root"

OMARCHY_SRC=/root/omarchy
VINOS_SHARE=/usr/share/vinos

[[ -d "$OMARCHY_SRC" ]] || die "$OMARCHY_SRC missing — this is not a vinOS 2.0 live ISO"
[[ -d "$VINOS_SHARE" ]] || die "$VINOS_SHARE missing — vinOS overlays not installed"

cat <<'BANNER'

    ┌─────────────────────────────────────────────┐
    │                                             │
    │   Welcome to vinOS 2.0                      │
    │                                             │
    │   T2 Mac-tuned Linux, hardened by default   │
    │                                             │
    └─────────────────────────────────────────────┘

BANNER

log "phase 1/2 — invoking system installer"
if [[ -x "$OMARCHY_SRC/install.sh" ]]; then
    ( cd "$OMARCHY_SRC" && bash ./install.sh )
elif [[ -x "$OMARCHY_SRC/boot.sh" ]]; then
    ( cd "$OMARCHY_SRC" && bash ./boot.sh )
else
    die "no installer entry point found in $OMARCHY_SRC"
fi

TARGET_ROOT=/mnt
if ! [[ -d "$TARGET_ROOT/etc" ]]; then
    warn "target root not mounted at $TARGET_ROOT — skipping vinOS overlays"
    warn "run the overlay scripts manually after reboot from $VINOS_SHARE/*/install.sh"
    exit 0
fi

log "phase 2/2 — applying vinOS overlays to target"

# Copy overlay materials into the target so post-boot install scripts can
# find them at /usr/share/vinos/.
mkdir -p "$TARGET_ROOT/usr/share/vinos"
rsync -a "$VINOS_SHARE/" "$TARGET_ROOT/usr/share/vinos/"

# Run each overlay install script inside the target chroot.
for pack in security mac brand; do
    script="/usr/share/vinos/$pack/install.sh"
    if [[ -x "$TARGET_ROOT$script" ]]; then
        log "  → $pack"
        arch-chroot "$TARGET_ROOT" bash "$script"
    else
        warn "  → $pack: $script missing or not executable"
    fi
done

# Stamp the target with vinOS release info.
cat > "$TARGET_ROOT/etc/vinos-release" <<EOF
NAME=vinOS
PRETTY_NAME="vinOS 2.0"
ID=vinos
VERSION="$(cat /etc/vinos-release 2>/dev/null | grep '^VERSION=' | cut -d= -f2- | tr -d '"' || echo 2.0.0)"
VERSION_ID=$(cat /etc/vinos-release 2>/dev/null | grep '^VERSION_ID=' | cut -d= -f2- || echo 2.0.0)
INSTALL_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
HOME_URL="https://vinos.computer/"
EOF

log "installation complete."
log "reboot to start using vinOS 2.0."
