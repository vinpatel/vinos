#!/usr/bin/env bash
# vinos-ux-smoke — after multi-user.target + greetd + Hyprland come up,
# verify the live-session UX actually works. Emits one summary line to
# /dev/ttyS0 the matrix greps for:
#
#   VINOS_UX_OK swaybg=YES|no hypr=YES|no ipc=YES|no wallpaper=YES|no foot=YES|no config=YES|no
#
# archiso live boot ends at multi-user.target — greetd is a multi-user
# service, graphical.target never activates. We poll for Hyprland
# readiness with retries (up to ~120 s) since the exec-once slate is
# spawned asynchronously from greetd's autologin.

set +e

_report() {
  local msg="$*"
  printf 'VINOS_UX_OK %s\n' "$msg" > /dev/ttyS0 2>/dev/null
  printf 'VINOS_UX_OK %s\n' "$msg" > /dev/kmsg  2>/dev/null
  logger -t vinos-ux-smoke "$msg" 2>/dev/null || true
  printf 'VINOS_UX_OK %s\n' "$msg"
}

_yesno() { [[ "$1" == "1" ]] && printf 'YES' || printf 'no'; }

# Poll for the Hyprland session for up to ~120 s. The vinos user is
# UID 1000 on the live ISO.
_hypr_uid=1000
_hypr_sock_dir=""
for i in $(seq 1 60); do
  # /run/user/1000/hypr/<INSTANCE_SIG>/ is the IPC dir
  _hypr_sock_dir=$(ls -d /run/user/$_hypr_uid/hypr/*/ 2>/dev/null | head -1)
  if [[ -n "$_hypr_sock_dir" ]] && pgrep -u $_hypr_uid -x Hyprland >/dev/null 2>&1; then
    break
  fi
  sleep 2
done

# Extra grace for exec-once slate (swaybg, waybar, mako).
sleep 5

# 1. swaybg
pgrep -u $_hypr_uid -x swaybg >/dev/null 2>&1
sway=$?

# 2. Hyprland
pgrep -u $_hypr_uid -x Hyprland >/dev/null 2>&1
hypr=$?

# 3. IPC socket
ipc=1
[[ -n "$_hypr_sock_dir" && -S "$_hypr_sock_dir/.socket.sock" ]] && ipc=0

# 4. wallpaper.png resolves + is a PNG
wp=1
if [[ -e /usr/share/vinos/wallpaper.png ]]; then
  head -c 8 /usr/share/vinos/wallpaper.png 2>/dev/null \
    | od -An -c | grep -q 'P   N   G' && wp=0
fi

# 5. foot
command -v foot >/dev/null 2>&1
foot=$?

# 6. hyprctl monitors succeeds
cfg=1
if [[ $hypr -eq 0 && -n "$_hypr_sock_dir" ]]; then
  _sig=$(basename "$_hypr_sock_dir")
  runuser -u vinos -- env \
    HYPRLAND_INSTANCE_SIGNATURE="$_sig" \
    XDG_RUNTIME_DIR="/run/user/$_hypr_uid" \
    hyprctl monitors >/dev/null 2>&1
  cfg=$?
fi

_report "swaybg=$(_yesno $((1-sway))) hypr=$(_yesno $((1-hypr))) ipc=$(_yesno $((1-ipc))) wallpaper=$(_yesno $((1-wp))) foot=$(_yesno $((1-foot))) config=$(_yesno $((1-cfg)))"
exit 0
