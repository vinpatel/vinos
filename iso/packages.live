# Live-ISO-only packages (not in the installer path).
# Merged into profile/packages.x86_64 by iso/gen-packages.sh alongside
# packages.releng and everything extracted from install/01-base.sh and
# install/02-desktop.sh.
#
# I7: NetworkManager removed — vinOS uses iwd+impala for wifi.
# iwd is already in packages.releng (base archiso profile).
gparted

# I12: broaden hardware support out of the box.
# sof-firmware — Sound Open Firmware, needed for audio on most 2019+
#                Intel laptops (Dell XPS, T2 Macs, Framework 13/16).
# linux-firmware-marvell — Marvell wifi (older ThinkPads, Chromebooks).
sof-firmware
linux-firmware-marvell

# I12: Apple T2 Mac support — from [arch-mact2] pacman repo defined
# in iso/profile/pacman.conf (NOT AUR). Ships linux-t2 as an alternate
# kernel entry so 2018-2020 MBP/MBA/iMacPro/MacMini boot with working
# keyboard, trackpad, GPU, and wifi from the live USB.
linux-t2
linux-t2-headers
apple-bcm-firmware
apple-t2-audio-config
tiny-dfr
t2fanrd
arch-mact2-mirrorlist

# Full hardware userspace so wifi/audio/GPU/BT/thermal/battery all
# work in the live session on 2019 Intel MBP + most modern laptops.
# linux-firmware (already in packages.releng) is a metapackage that
# pulls every per-vendor subpackage — we don't need to list them.

# GPU userspace (works alongside vendor firmware from linux-firmware):
mesa
vulkan-radeon
vulkan-intel
libva-mesa-driver
libva-intel-driver
intel-media-driver

# Bluetooth:
bluez
bluez-utils

# Audio config profiles beyond sof-firmware:
alsa-firmware
alsa-ucm-conf
alsa-utils

# Power management + thermals (matters on any laptop, especially T2 Macs):
power-profiles-daemon
thermald
acpid

# Thunderbolt device authorization daemon:
# bolt (already in packages.releng; keep here as a comment reminder).
