# Agent development conveniences (AUR only)
ollama-bin
claude-code
aichat
open-webui-bin

# Container ecosystem — extras beyond base packages
k9s
lazydocker
lazykube

# Terminal alternatives (build from AUR)

# Modern editors (AUR)
zed

# Additional agent-native tools
ttf-nerd-fonts-symbols-mono

