# vinOS AUR packages installed via local [vinos-aur] repo.
# gen-packages.sh merges these into packages.x86_64 + aur.list.
# aur-build.sh builds them in alphabetical order and caches in .aur-cache.

# Walker launcher engine (2.16+ split into elephant + walker-bin)
elephant

# T2 keyboard driver (older 2015-2017 MBPs — pre-2018 butterfly kb)
macbook12-spi-driver-dkms

# xdg-terminal-exec — walker / hypr keybind terminal resolver
xdg-terminal-exec

# Media apps — bound to keybindings
spotify

# 1Password (CLI + GUI) — bound to Super+/
1password
1password-cli

# System conveniences
tzupdate
ttf-ia-writer

