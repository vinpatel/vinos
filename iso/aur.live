# ISO-only AUR packages (installed via the local [vinos-aur] repo,
# NOT pulled by install/*.sh on installer path).
#
# Format: one package per line, comments and blanks ignored.
# gen-packages.sh merges these into both packages.x86_64 (so mkarchiso
# pacstraps them from vinos-aur) and aur.list (so aur-build.sh knows
# to build them).
#
# NOTE: T2 Mac support packages (linux-t2, apple-bcm-firmware,
# apple-t2-audio-config, tiny-dfr, t2fanrd) are NOT AUR — they live
# in the community [arch-mact2] pacman repo (see iso/profile/pacman.conf
# + iso/packages.live). Do NOT add them here.

# walker's new 2.16+ architecture split "elephant" into a separate
# AUR package that walker-bin depends on at runtime. aur-build.sh
# builds elephant first (alphabetical order) and pushes it into
# [vinos-aur] so walker-bin's makepkg -s can resolve it.
elephant
