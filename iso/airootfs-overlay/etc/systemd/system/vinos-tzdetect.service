[Unit]
Description=vinOS auto-detect timezone from IP geolocation
Documentation=file:///usr/share/doc/vinos/VINOS_ISO_SPEC.md
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target
Before=graphical.target systemd-user-sessions.service greetd.service
# Skip when a human (or the installer) has already picked a timezone.
ConditionPathExists=!/var/lib/vinos/tzdetect.done

[Service]
Type=oneshot
RemainAfterExit=yes
# Bounded, blocking: 6 in-process retries × 5 s max (30 s), then exit 0
# whether or not we succeeded. greetd.service.d/00-vinos-wait-tzdetect
# has After=+Wants= for this unit, so login is blocked until we return —
# Plymouth splash covers the wait, and the user never sees UTC on the
# desktop clock. With systemd-networkd-wait-online --timeout=15 gating
# network-online.target, wait-online has already handed us 15 s of Wi-Fi
# association budget by the time this service starts, so 30 s more is
# plenty for even a slow brcmfmac handshake + geoip curl.
ExecStart=/usr/bin/bash -eu -c '\
  mkdir -p /var/lib/vinos; \
  logger -t vinos-tzdetect "starting; route: $(ip route show default 2>/dev/null | head -1 || echo none)"; \
  tz=""; \
  for attempt in 1 2 3 4 5 6; do \
    logger -t vinos-tzdetect "attempt $attempt/6"; \
    if command -v tzupdate >/dev/null 2>&1; then \
      tz=$(tzupdate -p 2>/dev/null || true); \
      [ -n "$tz" ] && logger -t vinos-tzdetect "tzupdate returned: $tz"; \
    fi; \
    if [ -z "$tz" ]; then \
      tz=$(curl -fsS --max-time 4 https://ipapi.co/timezone 2>/dev/null || true); \
      [ -n "$tz" ] && logger -t vinos-tzdetect "ipapi.co returned: $tz"; \
    fi; \
    if [ -z "$tz" ] || ! grep -qE "^[A-Za-z_]+/[A-Za-z_/-]+$" <<<"$tz"; then \
      tz=$(curl -fsS --max-time 4 "http://ip-api.com/line?fields=timezone" 2>/dev/null || true); \
      [ -n "$tz" ] && logger -t vinos-tzdetect "ip-api returned: $tz"; \
    fi; \
    if [ -n "$tz" ] && grep -qE "^[A-Za-z_]+/[A-Za-z_/-]+$" <<<"$tz"; then \
      break; \
    fi; \
    tz=""; \
    logger -t vinos-tzdetect "attempt $attempt failed; sleeping 5 s"; \
    sleep 5; \
  done; \
  if [ -z "$tz" ]; then \
    logger -t vinos-tzdetect "all 6 attempts failed within 30 s budget; boot continues on UTC (hyprland exec-once will retry once network is up)"; \
    exit 0; \
  fi; \
  if [ -f "/usr/share/zoneinfo/$tz" ]; then \
    if timedatectl set-timezone "$tz"; then \
      echo "$tz" > /var/lib/vinos/tzdetect.done; \
      logger -t vinos-tzdetect "SUCCESS: timezone set to $tz"; \
    else \
      logger -t vinos-tzdetect "timedatectl set-timezone $tz FAILED; falling back to tzupdate direct write"; \
      tzupdate -t "$tz" 2>&1 | logger -t vinos-tzdetect && \
        echo "$tz" > /var/lib/vinos/tzdetect.done; \
    fi; \
  else \
    logger -t vinos-tzdetect "zoneinfo file /usr/share/zoneinfo/$tz missing; skipping"; \
  fi'
# ExecStart always exits 0 — no Restart= needed. If TZ wasn't set here,
# the Hyprland exec-once retry (config/hypr/autostart.conf) picks it up
# once the desktop is running, which will usually be after Wi-Fi is
# solidly online.

[Install]
WantedBy=multi-user.target
