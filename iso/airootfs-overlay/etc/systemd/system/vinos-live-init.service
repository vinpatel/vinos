[Unit]
Description=vinOS live: create vinos user + seed /home/vinos from /etc/skel
Documentation=file:///usr/share/doc/vinos/VINOS_ISO_SPEC.md
DefaultDependencies=no
After=systemd-tmpfiles-setup.service systemd-sysusers.service
Before=greetd.service systemd-user-sessions.service multi-user.target
ConditionPathExists=!/home/vinos/.vinos-live-init-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -eu -c '\
  if ! id vinos >/dev/null 2>&1; then \
    useradd -m -G wheel,video,audio,input,storage,network -s /bin/bash -c "vinOS live user" vinos; \
    passwd -d vinos; \
  else \
    usermod -aG video,audio,input,storage,network vinos; \
  fi; \
  if [ -d /etc/skel ]; then \
    cp -aRT /etc/skel /home/vinos/; \
    chown -R vinos:vinos /home/vinos; \
  fi; \
  install -m 0644 /dev/null /home/vinos/.vinos-live-init-done; \
  chown vinos:vinos /home/vinos/.vinos-live-init-done'

[Install]
WantedBy=multi-user.target
